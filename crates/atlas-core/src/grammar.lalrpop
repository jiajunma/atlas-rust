use super::{
    anonymous_field, assignment, binary, case_branch, case_expression, cast_expression, declaration,
    definition, elif_tail, else_branch, extend_operator_formula, forget_command, multi_assignment,
    component_assignment, component_transform, field_assignment, field_transform, operate_assignment,
    finish_let, expression_list, finish_operator_formula, for_expression, join_span, lambda,
    lambda_parameter, lambda_parameters, let_bindings, forget_overload_command,
    let_expression, list_expression, named_field, rec_function_binding, rec_lambda, return_expression,
    selector_suffix, operator_selector, sequence, set_command, set_type_command, show_overloads_command,
    operator_function_binding, operator_pattern,
    type_definition, type_spec_span,
    unit_selector, next_sequence, case_select_expression, counted_for_expression,
    tuple_expression, function_binding, quiet_if_expression,
    prepend_let_group,
    call_suffix, postfix, prefix_operator_call, slice_suffix, matrix_slice_suffix, start_binary_formula, start_prefix_formula,
    subscription_suffix, pair_index, type_group, type_function, type_primitive, type_row, type_union_append,
    type_union_start, type_variant, type_wild_row, unary, finish_conditional, if_tail,
    anonymous_parameter, const_pattern_name, finish_pattern, pattern_binding, pattern_empty_tuple,
    pattern_name, pattern_slots, pattern_tuple, tuple_parameter,
    whattype_command, while_expression, while_tail, guarded_body, bar_list_expression,
    BinaryOp, CaseBranch, Command, Expr, LambdaParam, LetBinding, ParsedFor, ParsedIf,
    ParsedLet, ParserToken, PatternTail, PostfixSuffix, Prim, Program, SlotTail, SpannedValue,
    TypeExpr, TypeField, TypeSpec, TypeVariantSlot, UnaryOp, Pattern, TypeDefinition,
    ParsedCaseSelect, ParsedCountedFor, ParsedIntCase,
    set_option_command,
};
use crate::diagnostic::SourceSpan;
use crate::formula::{FormulaOperator, FormulaStack};
use malachite::Integer as BigInt;
use super::type_scope::{ParserTypes, GroupKind};

grammar<'scope, 'types>(scope: &'scope ParserTypes<'types>);

pub Program: Program = {
    <first:Expr> <rest:("\n" <Expr>)*> "\n"? => {
        let mut expressions = vec![first];
        expressions.extend(rest);
        Program { expressions }
    }
};

// The runtime feeds one Atlas command at a time. Keeping this start symbol
// separate from Program prevents a syntax error in a later command from
// discarding values already produced by earlier commands.
pub Command: Command = {
    // parser.y:162 `IDENT ':' type`: the full type grammar (tuple, row,
    // function, void), including names classified by the live type table.
    <name:"identifier"> <_colon:":"> <value_type:TypeExprNode> => declaration(name, value_type),
    <name:"identifier"> <_colon:":"> <value:Expr> => definition(name, value),
    // set_type (parser.y:163-167): the single-name form aliases and the
    // bracketed form enters the tabled type map.
    <set_type:"set_type"> <name:SimpleTypeStart> <spec:ConstructorSpec> => {
        let end = type_spec_span(&spec);
        set_type_command(set_type, vec![type_definition(name, spec)], false, 0, end)
    },
    <set_type:"set_type"> <name:TypeOrIdentifier> "<" <arity:ConstructorArgs>
        ">" "=" <spec:ConstructorSpec> <bang:"!"> => {
        set_type_command(set_type, vec![type_definition(name, spec)], false, arity, bang)
    },
    <set_type:"set_type"> <_open:"["> <definitions:TypeEquations> <close:"]"> => {
        set_type_command(set_type, definitions, true, 0, close)
    },
    // '[' has opened the lexical group before AbstractionArgs reduces.
    // The formals disappear with ']', including on command recovery.
    <set_type:"set_type"> <arity:AbstractionArgs> <_open:"[">
        <definitions:TypeEquations> <close:"]"> => {
        set_type_command(set_type, definitions, true, arity, close)
    },
    // whattype id_op `?` (parser.y:187): list the overload instances of an
    // identifier or operator. The `?` cannot follow an expression or an
    // operator operand, so this never competes with the Expr form.
    <whattype:"whattype"> <name:ForgetTarget> <question:"?"> => {
        show_overloads_command(whattype, name, question)
    },
    <whattype:"whattype"> <target:Expr> => whattype_command(whattype, target),
    <whattype:"whattype"> <name:"type_name"> <_question:"?"?> => {
        whattype_command(whattype, Expr::Identifier { name: name.value, span: name.span })
    },
    <whattype:"whattype"> <name:"type_constructor"> <_question:"?"?> => {
        whattype_command(whattype, Expr::Identifier { name: name.value, span: name.span })
    },
    <showall:"showall"> => Command::ShowAll { span: showall },
    // set option (parser.y:171-178): `set quiet` / `set verbose` — the
    // command ends at the identifier, unlike the `set bindings` forms
    // which continue with `=`/`:`/`(`.
    <set:"set"> <name:"identifier"> => set_option_command(set, name),
    // set (parser.y:140): the `let` declaration forms, bound globally and
    // in parallel; function-typed leaves enter the overload table.
    <set:"set"> <bindings:LetBindings> => set_command(set, bindings),
    <start:"any_type"> <count:AbstractionArgs> "begin"
        <groups:PolymorphicDeclarations> <end:"end"> => Command::PolymorphicSet {
        count, bindings: groups, span: join_span(start, end),
    },
    // forget (parser.y:141-142,155-157): an identifier drops its global
    // binding; `name @ type` (identifier or operator) removes ONE overload.
    <forget:"forget"> <name:TypeOrIdentifier> => forget_command(forget, name),
    <forget:"forget"> <name:ForgetTarget> <_at:"@"> <signature:SpecTypeNode> => {
        forget_overload_command(forget, name, signature)
    },
    <expression:Expr> => Command::Expression(expression),
};

// The target of `forget … @ type` (parser.y:155-157): an overloaded
// function identifier or an operator, reduced to its plain name.
ForgetTarget: SpannedValue<String> = {
    <name:"identifier"> => name,
    <operator:Operator> => SpannedValue {
        value: operator.symbol,
        span: operator.span.expect("grammar operators carry spans"),
    },
};

// Original `id` accepts TYPE_ID as well as IDENT for type declarations and
// forgetting. Do not extend IDENT-only expression and binding productions.
TypeOrIdentifier: SpannedValue<String> = {
    <name:"identifier"> => name,
    <name:"type_name"> => name,
    <name:"type_constructor"> => name,
};

// parser.y type_args reduces on '>', before the body is scanned. Preserve
// duplicate formal slots; lookup inside the body uses their first occurrence.
ConstructorArgs: usize = {
    <first:"identifier"> <rest:("," <"identifier">)*> => {
        let mut names = vec![first.value];
        names.extend(rest.into_iter().map(|name| name.value));
        scope.push_group(GroupKind::Virtual);
        scope.introduce(&names);
        names.len()
    },
};

// parser.y id_eq opens a virtual lexical group until the complete type_spec.
// This also matters for an incomplete ordinary constructor application at a
// physical newline: the parser must request the following line, not recover
// early and execute it as an unrelated command.
SimpleTypeStart: SpannedValue<String> = {
    <name:TypeOrIdentifier> "=" => { scope.push_group(GroupKind::Virtual); name },
};

ConstructorSpec: TypeSpec = {
    <spec:TypeSpecNode> => { scope.pop_group(); spec },
};

// The '(' or BEGIN lookahead has ALREADY opened this lexical group in
// TokenStream. Unlike constructor formals, no extra virtual group is needed.
AbstractionArgs: usize = {
    <first:"identifier"> <rest:("," <"identifier">)*> => {
        let mut names = vec![first.value];
        names.extend(rest.into_iter().map(|name| name.value));
        scope.introduce(&names);
        names.len()
    },
};

// Original parser.y permits only SET declaration groups here, not arbitrary
// commands or nested generic command blocks. Flatten raw comma bindings too.
PolymorphicDeclarations: Vec<LetBinding> = {
    <groups:("set" <LetBindings>)+> => groups.into_iter().flatten().collect(),
};

pub Expr: Expr = {
    <let_span:"let"> <tail:LetTail> => let_expression(let_span, tail),
    <cast:Cast> => cast,
    // Lambda literals sit at the top expression level and
    // greedily take the rest of the expression (parser.y:224-238).
    <open:"("> <parameters:LambdaParameters> <_close:")"> ":" <body:Expr> => {
        lambda(open, parameters, body)
    },
    <open:"("> <parameters:LambdaParameters> <_close:")"> <body:Cast> => {
        lambda(open, parameters, body)
    },
    <rec_span:"rec_fun"> <self_name:"identifier"> <_open:"(">
        <parameters:LambdaParametersOpt> <_close:")">
        <result_type:TypeExprNode> ":" <body:Expr> => {
        rec_lambda(rec_span, self_name, parameters, result_type, body)
    },
    <at:"@"> ":" <body:Expr> => lambda(at, Vec::new(), body),
    <at:"@"> <body:Cast> => lambda(at, Vec::new(), body),
    // Sequencing (parser.y:243): `tertiary ';' expr`, right-recursive, so
    // `a; b; c` is `a; (b; c)`. `next` (parser.y:236) shares the
    // precedence but yields the FIRST operand's value.
    <first:AssignmentExpr> <_semicolon:";"> <rest:Expr> => sequence(first, rest),
    <first:AssignmentExpr> <_next:"next"> <rest:Expr> => next_sequence(first, rest),
    <expression:AssignmentExpr> => expression,
};

// Lambda parameters (parser.y `id_specs`): `type pattern`, the anonymous
// `type .`, or `(id_spec, …)` destructuring of one argument value. One
// list nonterminal serves both the lambda literal and a tuple parameter,
// so `(int a, int b): body` is a parameter list while `((int a, int b))`
// is a single destructuring parameter.
LambdaParametersOpt: Vec<LambdaParam> = {
    => Vec::new(),
    <parameters:LambdaParameters> => parameters,
};

LambdaParameters: Vec<LambdaParam> = {
    <first:LambdaParam> <rest:("," <LambdaParam>)*> => lambda_parameters(first, rest),
};

LambdaParam: LambdaParam = {
    <type_expr:TypeExprNode> <pattern:Pattern> => lambda_parameter(type_expr, pattern),
    <type_expr:TypeExprNode> <dot:"."> => anonymous_parameter(type_expr, dot),
    <open:"("> <elements:LambdaParameters> <close:")"> => tuple_parameter(open, elements, close),
};

// Binding patterns (parser.y:708-749): named, const `!x`, tuple
// destructuring with omitted slots, the `()` empty tuple, and the
// `(p, …): t` / `: !t` whole-value naming forms, which attach only to a
// comma-separated list. A single pattern in parentheses is grouping and
// collapses. Deferring the `)`/`,` decision into PatternTail keeps the
// grammar LR(1): no reduce competes with the grouping shift.
Pattern: Pattern = {
    <name:"identifier"> => pattern_name(name),
    <operator:DeclarationOperator> => operator_pattern(operator),
    <bang:"!"> <name:"identifier"> => const_pattern_name(bang, name),
    <open:"("> <close:")"> => pattern_empty_tuple(open, close),
    <open:"("> <first:Pattern> <tail:PatternTail> => finish_pattern(open, first, tail),
    <open:"("> <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*>
        <close:")"> <whole:WholeName?> => {
        pattern_tuple(open, pattern_slots(None, comma, second, rest), close, whole)
    },
};

PatternTail: PatternTail = {
    ")" => PatternTail::Group,
    <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*>
        <close:")"> <whole:WholeName?> => {
        PatternTail::Slots(Box::new(SlotTail {
            comma,
            second,
            rest,
            close,
            whole,
        }))
    },
};

WholeName: Pattern = {
    ":" <name:"identifier"> => pattern_name(name),
    ":" <bang:"!"> <name:"identifier"> => const_pattern_name(bang, name),
};

PatternOpt: Option<Pattern> = {
    => None,
    <pattern:Pattern> => Some(pattern),
};

// `type: expr` sits at the top expression level and greedily takes the rest,
// exactly as upstream (parser.y:224-240).
Cast: Expr = {
    <target:TypeExprNode> <_colon:":"> <body:Expr> => cast_expression(target, body),
};

TypeExprNode: TypeExpr = {
    <prim:"primitive_type"> => type_primitive(prim),
    <name:"type_name"> => TypeExpr::Named { name: name.value, span: name.span },
    <variable:"type_variable"> => TypeExpr::Variable { index: variable.value, span: variable.span },
    <name:"type_constructor"> "<" <first:TypeExprNode> <rest:("," <TypeExprNode>)*> <close:">"> => {
        let span = join_span(name.span, close);
        let mut arguments = vec![first];
        arguments.extend(rest);
        TypeExpr::Applied { name, arguments, span }
    },
    <span:"void"> => TypeExpr::Void { span },
    <closed:ClosedTypeNode> => closed,
};

// parser.y closed_type: explicit cast formals are introduced only after the
// opening bracket/parenthesis lookahead has opened their lexical group.
ClosedTypeNode: TypeExpr = {
    <open:"["> <inner:TypeUnionList> <close:"]"> => type_row(open, inner, close),
    <open:"["> <_star:"*"> <close:"]"> => type_wild_row(open, close),
    <open:"("> <inner:TypeUnionList> <close:")"> => type_group(open, inner, close),
    <open:"("> <argument:TypeUnionList?> <_arrow:"->"> <result:TypeUnionList?> <close:")"> => {
        type_function(open, argument, result, close)
    },
};

// A set_type right-hand side (parser.y:753-761 type_spec): a struct or
// union spec with named fields, or a plain type alias. The named/`
// anonymous decision is the token after a type (IDENT or `.`), so the
// plain-type path stays unambiguous.
TypeSpecNode: TypeSpec = {
    <_open:"("> <first:TypeFieldNode> <second:("," <TypeFieldNode>)>
        <rest:("," <TypeFieldNode>)*> <_close:")"> => {
        TypeSpec::Struct({
            let mut fields = vec![first, second];
            fields.extend(rest);
            fields
        })
    },
    <_open:"("> <first:TypeFieldNode> <second:("|" <TypeFieldNode>)>
        <rest:("|" <TypeFieldNode>)*> <_close:")"> => {
        TypeSpec::Union({
            let mut fields = vec![first, second];
            fields.extend(rest);
            fields
        })
    },
    <type_expr:SpecTypeNode> => TypeSpec::Alias(type_expr),
};

TypeFieldNode: TypeField = {
    <type_expr:SpecTypeNode> <name:"identifier"> => named_field(type_expr, name),
    <type_expr:SpecTypeNode> <dot:"."> => anonymous_field(type_expr, dot),
};

// Ordinary alias/constructor specifications. Bare old constructors are NOT
// types here: only grouped td_type below permits them (parser.y:1004+).
SpecTypeNode: TypeExpr = {
    <prim:"primitive_type"> => type_primitive(prim),
    <span:"void"> => TypeExpr::Void { span },
    <name:SpecTypeName> => TypeExpr::Named {
        name: name.value,
        span: name.span,
    },
    <variable:"type_variable"> => TypeExpr::Variable { index: variable.value, span: variable.span },
    <name:"type_constructor"> "<" <first:SpecTypeNode> <rest:("," <SpecTypeNode>)*> <close:">"> => {
        let span = join_span(name.span, close);
        let mut arguments = vec![first];
        arguments.extend(rest);
        TypeExpr::Applied { name, arguments, span }
    },
    <open:"["> <inner:SpecUnionList> <close:"]"> => type_row(open, inner, close),
    <open:"["> <_star:"*"> <close:"]"> => type_wild_row(open, close),
    <open:"("> <inner:SpecUnionList> <close:")"> => type_group(open, inner, close),
    <open:"("> <argument:SpecUnionList?> <_arrow:"->"> <result:SpecUnionList?> <close:")"> => {
        type_function(open, argument, result, close)
    },
};

SpecTypeName: SpannedValue<String> = {
    <name:"identifier"> => name,
    <name:"type_name"> => name,
};

SpecUnionList: Vec<TypeVariantSlot> = {
    <variant:SpecVariant> => type_union_start(Some(variant), false),
    <_bar:"|"> <variant:SpecVariant?> => type_union_start(variant, true),
    <list:SpecUnionList> <_bar:"|"> <variant:SpecVariant?> => type_union_append(list, variant),
};

SpecVariant: Vec<TypeExpr> = {
    <first:SpecTypeNode> <rest:("," <SpecTypeNode>)*> => type_variant(first, rest),
};

TypeEquations: Vec<TypeDefinition> = {
    <first:TypeEquation> <rest:("," <TypeEquation>)*> => {
        let mut definitions = vec![first];
        definitions.extend(rest);
        definitions
    },
};

TypeEquation: TypeDefinition = {
    <name:TypeOrIdentifier> <_equals:"="> <spec:GroupTypeSpec> => type_definition(name, spec),
};

// parser.y:974 typedef_type has a RESTRICTED root, unlike its nested td_type.
// A bare named/group/formal reference is rejected by parsing, not by the
// recursive graph builder. Primitive void is still allowed (PRIMTYPE upstream).
GroupTypeSpec: TypeSpec = {
    "(" <first:GroupTypeField> <second:("," <GroupTypeField>)>
        <rest:("," <GroupTypeField>)*> ")" => {
        let mut fields = vec![first, second]; fields.extend(rest);
        TypeSpec::Struct(fields)
    },
    "(" <first:GroupTypeField> <second:("|" <GroupTypeField>)>
        <rest:("|" <GroupTypeField>)*> ")" => {
        let mut fields = vec![first, second]; fields.extend(rest);
        TypeSpec::Union(fields)
    },
    <prim:"primitive_type"> => TypeSpec::Alias(type_primitive(prim)),
    <span:"void"> => TypeSpec::Alias(TypeExpr::Void { span }),
    <applied:GroupTypeApplication> => TypeSpec::Alias(applied),
    <open:"["> <inner:GroupUnionList> <close:"]"> => TypeSpec::Alias(type_row(open, inner, close)),
    <open:"("> <inner:GroupUnionListTwo> <close:")"> => TypeSpec::Alias(type_group(open, inner, close)),
    <open:"("> <argument:GroupUnionList?> "->" <result:GroupUnionList?> <close:")"> => {
        TypeSpec::Alias(type_function(open, argument, result, close))
    },
};

GroupTypeField: TypeField = {
    <type_expr:GroupTypeNode> <name:"identifier"> => named_field(type_expr, name),
    <type_expr:GroupTypeNode> <dot:"."> => anonymous_field(type_expr, dot),
};

GroupTypeApplication: TypeExpr = {
    <name:"type_constructor"> "<" <first:GroupTypeNode> <rest:("," <GroupTypeNode>)*> <close:">"> => {
        let span = join_span(name.span, close);
        let mut arguments = vec![first]; arguments.extend(rest);
        TypeExpr::Applied { name, arguments, span }
    },
};

GroupTypeNode: TypeExpr = {
    <prim:"primitive_type"> => type_primitive(prim),
    <span:"void"> => TypeExpr::Void { span },
    <name:TypeOrIdentifier> => TypeExpr::Named { name: name.value, span: name.span },
    <variable:"type_variable"> => TypeExpr::Variable { index: variable.value, span: variable.span },
    <applied:GroupTypeApplication> => applied,
    <open:"["> <inner:GroupUnionList> <close:"]"> => type_row(open, inner, close),
    <open:"("> <inner:GroupUnionList> <close:")"> => type_group(open, inner, close),
    <open:"("> <argument:GroupUnionList?> "->" <result:GroupUnionList?> <close:")"> => {
        type_function(open, argument, result, close)
    },
};

GroupUnionList: Vec<TypeVariantSlot> = {
    <single:GroupTypeNode> => type_union_start(Some(vec![single]), false),
    <multiple:GroupUnionListTwo> => multiple,
};

// At least two tuple components, OR a union containing an explicit bar.
// This distinction excludes `(int)` as a root while retaining it nested.
GroupUnionListTwo: Vec<TypeVariantSlot> = {
    <first:GroupTypeNode> <second:("," <GroupTypeNode>)> <rest:("," <GroupTypeNode>)*> => {
        let mut parts = vec![first, second]; parts.extend(rest);
        type_union_start(Some(parts), false)
    },
    <left:GroupUnionList?> "|" <right:GroupVariant?> => {
        match left {
            Some(left) => type_union_append(left, right),
            None => type_union_start(right, true),
        }
    },
};

GroupVariant: Vec<TypeExpr> = {
    <first:GroupTypeNode> <rest:("," <GroupTypeNode>)*> => type_variant(first, rest),
};

// `|`-separated variant slots; a missing slot is a void variant. Mirrors
// upstream union_list/types (parser.y:806-818).
TypeUnionList: Vec<TypeVariantSlot> = {
    <variant:TypeVariant> => type_union_start(Some(variant), false),
    <_bar:"|"> <variant:TypeVariant?> => type_union_start(variant, true),
    <list:TypeUnionList> <_bar:"|"> <variant:TypeVariant?> => type_union_append(list, variant),
};

TypeVariant: Vec<TypeExpr> = {
    <first:TypeExprNode> <rest:("," <TypeExprNode>)*> => type_variant(first, rest),
};

LetTail: ParsedLet = {
    <bindings:LetBindings> <_in:"in"> <body:Expr> => finish_let(bindings, body),
    <bindings:LetBindings> <_then:"then"> <tail:LetTail> => prepend_let_group(bindings, tail),
};

LetBindings: Vec<LetBinding> = {
    <first:LetBinding> <rest:("," <LetBinding>)*> => let_bindings(first, rest),
};

LetBinding: LetBinding = {
    <pattern:Pattern> <_equals:"="> <initializer:Expr> => pattern_binding(pattern, initializer),
    // A declaration has the same operator-function form globally, locally
    // and inside an any_type block. Bang is a symbol, not a formula operator.
    <operator:DeclarationOperator> <open:"(">
        <parameters:LambdaParametersOpt> <_close:")"> "=" <body:Expr> => {
        operator_function_binding(operator, open, parameters, body)
    },
    // `name(params) = body` and the rec_fun variant desugar to lambda
    // bindings (parser.y:251-257).
    <name:"identifier"> <open:"("> <parameters:LambdaParametersOpt> <_close:")">
        <_equals:"="> <body:Expr> => {
        function_binding(name, open, parameters, body)
    },
    <rec_span:"rec_fun"> <name:"identifier"> <_open:"(">
        <parameters:LambdaParametersOpt> <_close:")"> <_equals:"=">
        <result_type:TypeExprNode> ":" <body:Expr> => {
        rec_function_binding(rec_span, name, parameters, result_type, body)
    },
};

DeclarationOperator: FormulaOperator = {
    <operator:Operator> => operator,
    <span:"!"> => FormulaOperator::new("!", 0).with_span(span),
};

AssignmentExpr: Expr = {
    // parser.y::tertiary: RETURN tertiary. The operand does not consume
    // following ';' or NEXT; a grouped operand can explicitly include them.
    <return_span:"return"> <value:AssignmentExpr> => return_expression(return_span, value),
    <name:"identifier"> <_becomes:":="> <value:AssignmentExpr> => assignment(name, value),
    // Current parser.y::tertiary accepts both symbolic OPERATOR_BECOMES
    // and IDENT BECOMES, lowering both through the same operation call.
    <name:"identifier"> <operator:CompoundUpdate> <value:AssignmentExpr> => {
        operate_assignment(name, operator, value)
    },
    // `name[index] := value` and its reversed `~[` spelling (parser.y:265,
    // 578-586 `assignable_subsn`).
    <name:"identifier"> "[" <index:Expr> "]" ":=" <value:AssignmentExpr> => {
        component_assignment(name, index, false, value)
    },
    <name:"identifier"> "~[" <index:Expr> "]" ":=" <value:AssignmentExpr> => {
        component_assignment(name, index, true, value)
    },
    // Two-index forms (parser.y:585-598): the tuple index is rejected by
    // typing with the "in assignment" wording.
    <name:"identifier"> "[" <first:Expr> "," <second:Expr> "]" ":=" <value:AssignmentExpr> => {
        component_assignment(name, pair_index(first, second), false, value)
    },
    <name:"identifier"> "~[" <first:Expr> "," <second:Expr> "]" ":=" <value:AssignmentExpr> => {
        component_assignment(name, pair_index(first, second), true, value)
    },
    // `name.field := value` (parser.y:266).
    <name:"identifier"> "." <field:"identifier"> ":=" <value:AssignmentExpr> => {
        field_assignment(name, field, value)
    },
    // `name[index] op:= value` and `name.field op:= value` (parser.y:272-276).
    <name:"identifier"> "[" <index:Expr> "]" <operator:CompoundUpdate> <value:AssignmentExpr> => {
        component_transform(name, index, false, operator, value)
    },
    <name:"identifier"> "~[" <index:Expr> "]" <operator:CompoundUpdate> <value:AssignmentExpr> => {
        component_transform(name, index, true, operator, value)
    },
    <name:"identifier"> "[" <first:Expr> "," <second:Expr> "]" <operator:CompoundUpdate> <value:AssignmentExpr> => {
        component_transform(name, pair_index(first, second), false, operator, value)
    },
    <name:"identifier"> "~[" <first:Expr> "," <second:Expr> "]" <operator:CompoundUpdate> <value:AssignmentExpr> => {
        component_transform(name, pair_index(first, second), true, operator, value)
    },
    <name:"identifier"> "." <field:"identifier"> <operator:CompoundUpdate> <value:AssignmentExpr> => {
        field_transform(name, field, operator, value)
    },
    <set:"set"> <pattern:Pattern> <_becomes:":="> <value:AssignmentExpr> => {
        multi_assignment(set, pattern, value)
    },
    <expression:OrExpr> => expression,
};

CompoundUpdate: (SpannedValue<String>, bool) = {
    <operator:"operator_becomes"> => (operator, false),
    <operator:"identifier"> ":=" => (operator, true),
};

OrExpr: Expr = {
    <lhs:OrExpr> <_operator:"or"> <rhs:AndExpr> => binary(BinaryOp::Or, lhs, rhs),
    <expression:AndExpr> => expression,
};

AndExpr: Expr = {
    <lhs:AndExpr> <_operator:"and"> <rhs:NotExpr> => binary(BinaryOp::And, lhs, rhs),
    <expression:NotExpr> => expression,
};

NotExpr: Expr = {
    <operator:"not"> <operand:NotExpr> => unary(UnaryOp::Not, operand, operator),
    <expression:Secondary> => expression,
};

Secondary: Expr = {
    <formula:Formula> => formula,
    <postfix:Postfix> => postfix,
};

// This mirrors Atlas's deliberately flat Bison grammar. FormulaStack performs
// the dynamic priority and associativity reductions in parser actions.
Formula: Expr = {
    <stack:FormulaStart> <operand:Operand> => finish_operator_formula(stack, operand),
};

FormulaStart: FormulaStack<Expr> = {
    <operator:Operator> => start_prefix_formula(operator),
    <postfix:Postfix> <operator:Operator> => start_binary_formula(postfix, operator),
    <stack:FormulaStart> <operand:Operand> <operator:Operator> => {
        extend_operator_formula(stack, operand, operator)
    },
};

// A prefix operator following another operator binds immediately, exactly as
// the reference parser's `operand : operator operand` rule requires.
Operand: Expr = {
    <operator:Operator> <operand:Operand> => prefix_operator_call(operator, operand),
    <postfix:Postfix> => postfix,
};

Operator: FormulaOperator = {
    <operator:"operator"> => operator.value,
    <span:"*"> => FormulaOperator::new("*", 6).with_span(span),
    <span:"="> => FormulaOperator::new("=", 2).with_span(span),
    <span:"<"> => FormulaOperator::new("<", 2).with_span(span),
    <span:">"> => FormulaOperator::new(">", 2).with_span(span),
};

Postfix: Expr = {
    // A bare identifier anchors its own suffix chain (rather than reducing
    // through `Atom`) so the assignment productions (parser.y:263-276) can
    // share the `IDENT` prefix without a shift/reduce conflict — the same
    // reason upstream routes `IDENT '[' expr ']'` through `assignable_subsn`
    // (parser.y:578-586,601).
    <name:"identifier"> <suffixes:PostfixSuffix*> => suffixes.into_iter().fold(
        Expr::Identifier { name: name.value, span: name.span },
        postfix,
    ),
    <base:Atom> <suffixes:PostfixSuffix*> => suffixes.into_iter().fold(base, postfix),
};

PostfixSuffix: PostfixSuffix = {
    // parser.y:389: primary '!' is unary application of the bang symbol.
    // Its span follows the receiver, just as an operator selector does.
    <span:"!"> => operator_selector(FormulaOperator::new("!", 0).with_span(span)),
    <_open:"["> <index:Expr> <close:"]"> => subscription_suffix(index, false, close),
    <_open:"~["> <index:Expr> <close:"]"> => subscription_suffix(index, true, close),
    // Two-index subscription `M[i,j]` / `M~[i,j]` (parser.y:585-598,
    // 606-613): exactly two indices forming a tuple display; typing then
    // rejects the tuple index with the "Cannot subscript …" diagnostic.
    <_open:"["> <first:Expr> <_comma:","> <second:Expr> <close:"]"> =>
        subscription_suffix(pair_index(first, second), false, close),
    <_open:"~["> <first:Expr> <_comma:","> <second:Expr> <close:"]"> =>
        subscription_suffix(pair_index(first, second), true, close),
    <subject_reversed:SliceOpen> <lower:Expr?> <lower_reversed:TildeOpt>
        <colon:":"> <upper:Expr?> <upper_reversed:TildeOpt> <close:"]"> => {
        slice_suffix(
            lower,
            upper,
            subject_reversed,
            lower_reversed,
            upper_reversed,
            colon,
            close,
        )
    },
    // Two-dimensional slice `M[rlo:rhi, clo:chi]` (parser.y:660-705).
    // Upstream has no `~[` form here, so the open bracket is literal.
    <_open:"["> <row_lower:Expr?> <row_lower_reversed:TildeOpt>
        <colon:":"> <row_upper:Expr?> <row_upper_reversed:TildeOpt>
        <_comma:","> <column_lower:Expr?> <column_lower_reversed:TildeOpt>
        <_column_colon:":"> <column_upper:Expr?> <column_upper_reversed:TildeOpt>
        <close:"]"> => {
        matrix_slice_suffix(
            row_lower,
            row_upper,
            row_lower_reversed,
            row_upper_reversed,
            column_lower,
            column_upper,
            column_lower_reversed,
            column_upper_reversed,
            colon,
            close,
        )
    },
    <_open:"("> <arguments:CallArguments> <close:")"> => call_suffix(arguments, close),
    // `receiver.name` lowers to `name(receiver)`; unit and operator
    // selectors (parser.y:391-394) apply the unit or the operator's
    // prefix form to the receiver.
    <_dot:"."> <name:"identifier"> => selector_suffix(name),
    <_dot:"."> <operator:Operator> => operator_selector(operator),
    <_dot:"."> <unit:UnitSelector> => unit_selector(unit),
};

// `selector: unit` also includes grouped functions, control expressions and
// type abstractions. Share the full unit grammar, not just scalar literals.
UnitSelector: Expr = {
    <unit:UnitAtom> => unit,
};

#[inline]
SliceOpen: bool = {
    "[" => false,
    "~[" => true,
};

#[inline]
TildeOpt: bool = {
    => false,
    "~" => true,
};

CallArguments: Vec<Expr> = {
    => Vec::new(),
    <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

Atom: Expr = {
    <open:"("> <close:")"> => tuple_expression(open, Vec::new(), close),
    <unit:UnitAtom> => unit,
};

UnitAtom: Expr = {
    <name:"identifier"> "@" <argument_type:OperatorCastType> => {
        let span = join_span(name.span, argument_type.span());
        Expr::OperatorCast { name, argument_type: Box::new(argument_type), span }
    },
    <operator:DeclarationOperator> "@" <argument_type:OperatorCastType> => {
        let start = operator.span.expect("grammar operators carry spans");
        Expr::OperatorCast {
            name: SpannedValue { value: operator.symbol, span: start },
            span: join_span(start, argument_type.span()), argument_type: Box::new(argument_type),
        }
    },
    <start:"any_type"> <count:AbstractionArgs> "(" <body:Expr> <end:")"> => {
        Expr::TypeAbstraction { count, body: Box::new(body), span: join_span(start, end) }
    },
    <start:"any_type"> <count:AbstractionArgs> "begin" <body:Expr> <end:"end"> => {
        Expr::TypeAbstraction { count, body: Box::new(body), span: join_span(start, end) }
    },
    <if_span:"if"> <tail:IfTail> => finish_conditional(if_span, tail),
    <integer:"integer"> => Expr::Integer { value: integer.value, span: integer.span },
    <boolean:"boolean"> => Expr::Boolean { value: boolean.value, span: boolean.span },
    <string:"string"> => Expr::String { value: string.value, span: string.span },
    <open:"["> <elements:ListElements> <close:"]"> => list_expression(open, elements, close),
    // commabarlist (parser.y:370-376, :402-410): `[a,b | c,d]` builds the
    // matrix whose ROWS are the comma-separated segments (upstream:
    // `transpose (mat: [[a,b],[c,d]])` via the hidden `"transpose "`).
    <open:"["> <rows:CommaBarList> <close:"]"> => bar_list_expression(open, rows, close),
    <open:"("> <first:Expr> <rest:TupleTail> <close:")"> => {
        tuple_expression(open, expression_list(first, rest), close)
    },
    <open:"("> <inner:Expr> <close:")"> => Expr::Group {
        span: join_span(open, close),
        inner: Box::new(inner),
    },
    <open:"begin"> <inner:Expr> <close:"end"> => Expr::Group {
        span: join_span(open, close),
        inner: Box::new(inner),
    },
    // Loops and `break` are units upstream (parser.y:364,473-474,506-531).
    <while_span:"while"> <tail:WhileTail> => while_expression(while_span, tail),
    <loop_:IfForLoop> => loop_,
    // Current parser.y:461-462 repeats BREAK tokens; numeric break N is
    // historical syntax rejected by original3838661.
    <start:"break"> <rest:"break"*> => {
        let end = rest.last().copied().unwrap_or(start);
        Expr::Break { levels: rest.len(), span: join_span(start, end) }
    },
    // `die` (parser.y:383): a unit that type-checks anywhere and throws
    // `I die` when evaluated.
    <span:"die"> => Expr::Die { span },
    // Case discrimination (parser.y:480-482, caselist): `case subject |
    // tag(pattern): body | tag: body | else body esac`.
    <case:"case"> <subject:Expr> <_bar:"|"> <branches:CaseBranches> <esac:"esac"> => {
        case_expression(case, subject, branches, esac)
    },
    // Integer selection and positional union case (parser.y:350-359).
    <case:"case"> <condition:Expr> <tail:CaseSelectTail> => {
        case_select_expression(case, condition, tail)
    },
};

OperatorCastType: TypeExpr = {
    <argument_type:TypeExprNode> => argument_type,
    <_count:AbstractionArgs> <argument_type:ClosedTypeNode> => argument_type,
};

// The tail of an integer/union `case`: the keyword-permuted `then`/`else`
// variants (parser.y:352-358) normalise into one AST, and the `|` branch
// list marks the positional union form (parser.y:359).
CaseSelectTail: ParsedCaseSelect = {
    "else" <else_branch:Expr> "in" <branches:CaseCommaList> <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase { branches, then_branch: None, else_branch: Some(else_branch), esac }))
    },
    "then" <then_branch:Expr> "in" <branches:CaseCommaList> "else" <else_branch:Expr>
        <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase { branches, then_branch: Some(then_branch), else_branch: Some(else_branch), esac }))
    },
    "then" <then_branch:Expr> "else" <else_branch:Expr> "in" <branches:CaseCommaList>
        <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase { branches, then_branch: Some(then_branch), else_branch: Some(else_branch), esac }))
    },
    "in" <first:Expr> <tail:CaseInTail> => tail.into_case_select(vec![first]),
};

// After `case condition in first`: the branch list continues with `,`
// (integer case), with `|` (positional union case), or ends; the integer
// form may still gain `then`/`else` branches (parser.y:351,355).
CaseInTail: ParsedCaseSelect = {
    <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: None, esac,
    })),
    "else" <else_branch:Expr> <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: Some(else_branch), esac,
    })),
    "then" <then_branch:Expr> "else" <else_branch:Expr> <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase {
            branches: Vec::new(), then_branch: Some(then_branch), else_branch: Some(else_branch), esac,
        }))
    },
    "," <rest:CaseCommaList> <tail:CaseCommaEnd> => tail.into_case_select(rest),
    "|" <second:Expr> <rest:("|" <Expr>)*> <esac:"esac"> => {
        let mut branches = vec![second];
        branches.extend(rest);
        ParsedCaseSelect::Union { branches, esac }
    },
};

CaseCommaEnd: ParsedCaseSelect = {
    <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: None, esac,
    })),
    "else" <else_branch:Expr> <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: Some(else_branch), esac,
    })),
    "then" <then_branch:Expr> "else" <else_branch:Expr> <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase {
            branches: Vec::new(), then_branch: Some(then_branch), else_branch: Some(else_branch), esac,
        }))
    },
};

CaseCommaList: Vec<Expr> = {
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

CaseBranches: Vec<CaseBranch> = {
    <first:CaseBranch> <rest:("|" <CaseBranch>)*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

CaseBranch: CaseBranch = {
    <tag:"identifier"> <_colon:":"> <body:Expr> => case_branch(tag, None, body),
    <tag:"identifier"> <pattern:CasePattern> <_colon:":"> <body:Expr> => {
        case_branch(tag, Some(pattern), body)
    },
    <pattern:CasePattern> "." <tag:"identifier"> ":" <body:Expr> => {
        case_branch(tag, Some(pattern), body)
    },
    <else_span:"else"> <body:Expr> => else_branch(else_span, body),
};

// Upstream closed_pattern (parser.y:717-720): a parenthesised pattern
// (single patterns collapse), a tuple slot list, or the `()` empty tuple.
// Unlike a let-binding pattern it takes no `: name` whole-value tail — the
// branch `:` would be ambiguous with it — so the tail rules are mirrored
// here minus WholeName.
CasePattern: Pattern = {
    <open:"("> <close:")"> => pattern_empty_tuple(open, close),
    <open:"("> <first:Pattern> <tail:CasePatternTail> => finish_pattern(open, first, tail),
    <open:"("> <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*>
        <close:")"> => {
        pattern_tuple(open, pattern_slots(None, comma, second, rest), close, None)
    },
};

CasePatternTail: PatternTail = {
    ")" => PatternTail::Group,
    <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*> <close:")"> => {
        PatternTail::Slots(Box::new(SlotTail {
            comma,
            second,
            rest,
            close,
            whole: None,
        }))
    },
};

// The guard/body stays below all let/choice scopes (parser.y:515-581).
WhileTail: (Option<Expr>, Expr, SourceSpan, bool) = {
    <body:DoExpr> <reversed:TildeOpt> <od:"od"> => while_tail(body, od, reversed),
};

DoExpr: Expr = {
    <effect:AssignmentExpr> ";" <body:DoExpr> => sequence(effect, body),
    <condition:AssignmentExpr> "do" <body:Expr> => {
        let start = condition.span();
        guarded_body(Some(condition), body, start)
    },
    <start:"do"> <body:Expr> => guarded_body(None, body, start),
    <span:"dont"> => Expr::Dont { span },
    <start:"let"> <tail:DoLetTail> => let_expression(start, tail),
    <start:"if"> <tail:DoIfTail> => finish_conditional(start, tail),
    <start:"case"> <subject:Expr> "|" <branches:DoCaseBranches> <end:"esac"> => {
        case_expression(start, subject, branches, end)
    },
    <start:"case"> <condition:Expr> <tail:DoCaseTail> => case_select_expression(start, condition, tail),
    "(" <body:DoExpr> ")" => body,
};

DoLetTail: ParsedLet = {
    <bindings:LetBindings> "in" <body:DoExpr> => finish_let(bindings, body),
    <bindings:LetBindings> "then" <tail:DoLetTail> => prepend_let_group(bindings, tail),
};

DoIfTail: ParsedIf = {
    <condition:Expr> "then" <yes:DoExpr> "else" <no:DoExpr> <end:"fi"> => if_tail(condition, yes, Some(no), end),
    <condition:Expr> "then" <yes:DoExpr> "elif" <tail:DoIfTail> => elif_tail(condition, yes, tail),
    <condition:Expr> "else" <no:DoExpr> "then" <yes:DoExpr> <end:"fi"> => if_tail(condition, yes, Some(no), end),
};

DoCaseBranches: Vec<CaseBranch> = {
    <first:DoCaseBranch> <rest:("|" <DoCaseBranch>)*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

DoCaseBranch: CaseBranch = {
    <tag:"identifier"> ":" <body:DoExpr> => case_branch(tag, None, body),
    <tag:"identifier"> <pattern:CasePattern> ":" <body:DoExpr> => case_branch(tag, Some(pattern), body),
    <pattern:CasePattern> "." <tag:"identifier"> ":" <body:DoExpr> => case_branch(tag, Some(pattern), body),
    <start:"else"> <body:DoExpr> => else_branch(start, body),
};

DoCommaList: Vec<Expr> = {
    <first:DoExpr> <rest:("," <DoExpr>)*> => expression_list(first, rest),
};

DoCaseTail: ParsedCaseSelect = {
    "in" <branches:DoCommaList> <end:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches, then_branch: None, else_branch: None, esac: end,
    })),
    "in" <branches:DoCommaList> "else" <no:DoExpr> <end:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches, then_branch: None, else_branch: Some(no), esac: end,
    })),
    "else" <no:DoExpr> "in" <branches:DoCommaList> <end:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches, then_branch: None, else_branch: Some(no), esac: end,
    })),
    "in" <branches:DoCommaList> "then" <yes:DoExpr> "else" <no:DoExpr> <end:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches, then_branch: Some(yes), else_branch: Some(no), esac: end,
    })),
    "then" <yes:DoExpr> "in" <branches:DoCommaList> "else" <no:DoExpr> <end:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches, then_branch: Some(yes), else_branch: Some(no), esac: end,
    })),
    "then" <yes:DoExpr> "else" <no:DoExpr> "in" <branches:DoCommaList> <end:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches, then_branch: Some(yes), else_branch: Some(no), esac: end,
    })),
};

// Quiet IF contributes a singleton/empty row. Nested loop bodies already
// produce rows; only an enclosing FOR joins those rows (parser.y:583-652).
IfForLoop: Expr = {
    <start:"if"> <condition:Expr> "do" <body:Expr> <end:"fi"> => {
        quiet_if_expression(start, condition, body, end, true)
    },
    <start:"if"> <condition:Expr> <body:IfForLoop> <end:"fi"> => {
        quiet_if_expression(start, condition, body, end, false)
    },
    <start:"for"> <tail:ForTail> => for_expression(start, tail),
    <start:"for"> <tail:CountedForTail> => counted_for_expression(start, tail),
};

ForBody: (Expr, bool) = {
    "do" <body:Expr> => (body, false),
    <body:IfForLoop> => (body, true),
};

// `FOR pattern_opt ['@' IDENT] IN expr DO expr OD` (parser.y:598-621); the
// loop pattern reuses the let-binding pattern grammar, exactly like the
// upstream pair wrap (pattern, index).
ForTail: ParsedFor = {
    <pattern:ForPattern> <index:ForIndex?> <_in:"in"> <iterable:Expr> <input_reversed:TildeOpt>
        <body:ForBody> <output_reversed:TildeOpt> <od:"od"> => {
        ParsedFor { pattern, index, iterable, body: body.0, flatten: body.1, input_reversed, output_reversed, od }
    },
};

// Counted for loops (parser.y:550-573): `FOR IDENT ':' count [FROM bound |
// DOWNTO bound] DO body OD`, or the anonymous `FOR ':' count DO body OD`.
CountedForTail: ParsedCountedFor = {
    <name:"identifier"> ":" <count:Expr> "from" <bound:Expr> <decreasing:TildeOpt> <body:ForBody> <output_reversed:TildeOpt> <od:"od"> => {
        ParsedCountedFor { name: Some(name), count, bound: Some(bound), decreasing, output_reversed, body: body.0, flatten: body.1, od }
    },
    <name:"identifier"> ":" <count:Expr> "downto" <bound:Expr> <body:ForBody> <od:"od"> => {
        ParsedCountedFor { name: Some(name), count, bound: Some(bound), decreasing: true, output_reversed: false, body: body.0, flatten: body.1, od }
    },
    <name:"identifier"> ":" <count:Expr> <decreasing:TildeOpt> <body:ForBody> <output_reversed:TildeOpt> <od:"od"> => {
        ParsedCountedFor { name: Some(name), count, bound: None, decreasing, output_reversed, body: body.0, flatten: body.1, od }
    },
    ":" <count:Expr> <body:ForBody> <output_reversed:TildeOpt> <od:"od"> => {
        ParsedCountedFor { name: None, count, bound: None, decreasing: false, output_reversed, body: body.0, flatten: body.1, od }
    },
};

ForPattern: Option<Pattern> = {
    => None,
    <pattern:Pattern> => Some(pattern),
};

ForIndex: SpannedValue<String> = {
    <_at:"@"> <name:"identifier"> => name,
};

// Upstream iftail (parser.y:412-419) plus the inverted else-first form.
IfTail: ParsedIf = {
    <condition:Expr> "then" <then_branch:Expr> "else" <else_branch:Expr> <close:"fi"> => {
        if_tail(condition, then_branch, Some(else_branch), close)
    },
    <condition:Expr> "then" <then_branch:Expr> <close:"fi"> => {
        if_tail(condition, then_branch, None, close)
    },
    <condition:Expr> "then" <then_branch:Expr> "elif" <tail:IfTail> => {
        elif_tail(condition, then_branch, tail)
    },
    <condition:Expr> "else" <else_branch:Expr> "then" <then_branch:Expr> <close:"fi"> => {
        if_tail(condition, then_branch, Some(else_branch), close)
    },
};

TupleTail: Vec<Expr> = {
    <_comma:","> <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

ListElements: Vec<Expr> = {
    => Vec::new(),
    <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

// commalist (parser.y:398-400): one or more comma-separated expressions.
CommaList: Vec<Expr> = {
    <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

// commabarlist (parser.y:402-410): two or more comma-lists separated by
// `|`; each segment is a non-empty row of the resulting matrix display.
CommaBarList: Vec<Vec<Expr>> = {
    <first:CommaList> <_bar:"|"> <second:CommaList> <rest:("|" <CommaList>)*> => {
        let mut rows = vec![first, second];
        rows.extend(rest);
        rows
    },
};

extern {
    type Location = usize;
    type Error = ();

    enum ParserToken {
        "integer" => ParserToken::Integer(<SpannedValue<BigInt>>),
        "boolean" => ParserToken::Boolean(<SpannedValue<bool>>),
        "string" => ParserToken::String(<SpannedValue<String>>),
        "identifier" => ParserToken::Identifier(<SpannedValue<String>>),
        "type_name" => ParserToken::TypeName(<SpannedValue<String>>),
        "type_constructor" => ParserToken::TypeConstructor(<SpannedValue<String>>),
        "type_variable" => ParserToken::TypeVariable(<SpannedValue<usize>>),
        "operator" => ParserToken::Operator(<SpannedValue<FormulaOperator>>),
        "operator_becomes" => ParserToken::OperatorBecomes(<SpannedValue<String>>),
        "primitive_type" => ParserToken::PrimitiveType(<SpannedValue<Prim>>),
        ":=" => ParserToken::Becomes(<SourceSpan>),
        "=" => ParserToken::Equals(<SourceSpan>),
        "<" => ParserToken::Less(<SourceSpan>),
        ">" => ParserToken::Greater(<SourceSpan>),
        "*" => ParserToken::Star(<SourceSpan>),
        "void" => ParserToken::VoidType(<SourceSpan>),
        "|" => ParserToken::Bar(<SourceSpan>),
        "->" => ParserToken::Arrow(<SourceSpan>),
        ":" => ParserToken::Colon(<SourceSpan>),
        "," => ParserToken::Comma(<SourceSpan>),
        "[" => ParserToken::LBracket(<SourceSpan>),
        "~[" => ParserToken::ReverseLBracket(<SourceSpan>),
        "]" => ParserToken::RBracket(<SourceSpan>),
        "~" => ParserToken::Tilde(<SourceSpan>),
        "let" => ParserToken::Let(<SourceSpan>),
        "in" => ParserToken::In(<SourceSpan>),
        "begin" => ParserToken::Begin(<SourceSpan>),
        "end" => ParserToken::End(<SourceSpan>),
        "then" => ParserToken::Then(<SourceSpan>),
        "if" => ParserToken::If(<SourceSpan>),
        "else" => ParserToken::Else(<SourceSpan>),
        "elif" => ParserToken::Elif(<SourceSpan>),
        "fi" => ParserToken::Fi(<SourceSpan>),
        "and" => ParserToken::And(<SourceSpan>),
        "or" => ParserToken::Or(<SourceSpan>),
        "not" => ParserToken::Not(<SourceSpan>),
        "return" => ParserToken::Return(<SourceSpan>),
        "rec_fun" => ParserToken::RecFun(<SourceSpan>),
        "while" => ParserToken::While(<SourceSpan>),
        "for" => ParserToken::For(<SourceSpan>),
        "do" => ParserToken::Do(<SourceSpan>),
        "od" => ParserToken::Od(<SourceSpan>),
        "break" => ParserToken::Break(<SourceSpan>),
        "dont" => ParserToken::Dont(<SourceSpan>),
        "die" => ParserToken::Die(<SourceSpan>),
        "?" => ParserToken::Question(<SourceSpan>),
        "set" => ParserToken::Set(<SourceSpan>),
        "set_type" => ParserToken::SetType(<SourceSpan>),
        "any_type" => ParserToken::AnyType(<SourceSpan>),
        "whattype" => ParserToken::Whattype(<SourceSpan>),
        "showall" => ParserToken::Showall(<SourceSpan>),
        "forget" => ParserToken::Forget(<SourceSpan>),
        "case" => ParserToken::Case(<SourceSpan>),
        "esac" => ParserToken::Esac(<SourceSpan>),
        "next" => ParserToken::Next(<SourceSpan>),
        "from" => ParserToken::From(<SourceSpan>),
        "downto" => ParserToken::Downto(<SourceSpan>),
        "quit" => ParserToken::Quit(<SourceSpan>),
        ";" => ParserToken::Semicolon(<SourceSpan>),
        "!" => ParserToken::Bang(<SourceSpan>),
        "@" => ParserToken::At(<SourceSpan>),
        "." => ParserToken::Dot(<SourceSpan>),
        "(" => ParserToken::LParen(<SourceSpan>),
        ")" => ParserToken::RParen(<SourceSpan>),
        "\n" => ParserToken::Newline(<SourceSpan>),
        "unsupported" => ParserToken::Unsupported(<SpannedValue<String>>),
    }
}
