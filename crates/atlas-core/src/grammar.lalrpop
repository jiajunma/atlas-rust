use super::{
    anonymous_field, assignment, binary, case_branch, case_expression, cast_expression, declaration,
    definition, elif_tail, else_branch, extend_operator_formula, forget_command, multi_assignment,
    finish_let, expression_list, finish_operator_formula, for_expression, join_span, lambda,
    lambda_parameter, lambda_parameters, let_bindings, forget_overload_command,
    let_expression, list_expression, named_field, rec_function_binding, rec_lambda, return_expression,
    selector_suffix, operator_selector, sequence, set_command, set_type_command, show_overloads_command,
    operator_function_binding,
    type_definition, type_spec_span,
    unit_selector, next_sequence, case_select_expression, counted_for_expression,
    tuple_expression, function_binding,
    prepend_let_group,
    call_suffix, postfix, prefix_operator_call, slice_suffix, start_binary_formula, start_prefix_formula,
    subscription_suffix, type_group, type_function, type_primitive, type_row, type_union_append,
    type_union_start, type_variant, type_wild_row, unary, finish_conditional, if_tail,
    anonymous_parameter, const_pattern_name, finish_pattern, pattern_binding, pattern_empty_tuple,
    pattern_name, pattern_slots, pattern_tuple, prepend_while_effect, tuple_parameter,
    whattype_command, while_expression,
    BinaryOp, CaseBranch, Command, Expr, LambdaParam, LetBinding, ParsedFor, ParsedIf,
    ParsedLet, ParserToken, PatternTail, PostfixSuffix, Prim, Program, SlotTail, SpannedValue,
    TypeExpr, TypeField, TypeSpec, TypeVariantSlot, UnaryOp, Pattern, TypeDefinition,
    ParsedCaseSelect, ParsedCountedFor, ParsedIntCase,
    set_option_command,
};
use crate::diagnostic::SourceSpan;
use crate::formula::{FormulaOperator, FormulaStack};
use malachite::Integer as BigInt;

grammar;

pub Program: Program = {
    <first:Expr> <rest:("\n" <Expr>)*> "\n"? => {
        let mut expressions = vec![first];
        expressions.extend(rest);
        Program { expressions }
    }
};

// The runtime feeds one Atlas command at a time. Keeping this start symbol
// separate from Program prevents a syntax error in a later command from
// discarding values already produced by earlier commands.
pub Command: Command = {
    // parser.y:162 `IDENT ':' type`: the full type grammar (tuple, row,
    // function, void), not just a primitive name. Named types stay out
    // (the lexer has no type-table token), matching TypeExprNode.
    <name:"identifier"> <_colon:":"> <value_type:TypeExprNode> => declaration(name, value_type),
    <name:"identifier"> <_colon:":"> <value:Expr> => definition(name, value),
    // set_type (parser.y:163-167): the single-name form aliases and the
    // bracketed form enters the tabled type map.
    <set_type:"set_type"> <name:"identifier"> <_equals:"="> <spec:TypeSpecNode> => {
        let end = type_spec_span(&spec);
        set_type_command(set_type, vec![type_definition(name, spec)], false, end)
    },
    <set_type:"set_type"> <_open:"["> <definitions:TypeEquations> <close:"]"> => {
        set_type_command(set_type, definitions, true, close)
    },
    // whattype id_op `?` (parser.y:187): list the overload instances of an
    // identifier or operator. The `?` cannot follow an expression or an
    // operator operand, so this never competes with the Expr form.
    <whattype:"whattype"> <name:ForgetTarget> <question:"?"> => {
        show_overloads_command(whattype, name, question)
    },
    <whattype:"whattype"> <target:Expr> => whattype_command(whattype, target),
    <showall:"showall"> => Command::ShowAll { span: showall },
    // set option (parser.y:171-178): `set quiet` / `set verbose` — the
    // command ends at the identifier, unlike the `set bindings` forms
    // which continue with `=`/`:`/`(`.
    <set:"set"> <name:"identifier"> => set_option_command(set, name),
    // set (parser.y:140): the `let` declaration forms, bound globally and
    // in parallel; function-typed leaves enter the overload table.
    <set:"set"> <operator:Operator> <open:"(">
        <parameters:LambdaParametersOpt> <_close:")"> <_equals:"="> <body:Expr> => {
        set_command(set, vec![operator_function_binding(operator, open, parameters, body)])
    },
    <set:"set"> <bindings:LetBindings> => set_command(set, bindings),
    // forget (parser.y:141-142,155-157): an identifier drops its global
    // binding; `name @ type` (identifier or operator) removes ONE overload.
    <forget:"forget"> <name:"identifier"> => forget_command(forget, name),
    <forget:"forget"> <name:ForgetTarget> <_at:"@"> <signature:SpecTypeNode> => {
        forget_overload_command(forget, name, signature)
    },
    <expression:Expr> => Command::Expression(expression),
};

// The target of `forget … @ type` (parser.y:155-157): an overloaded
// function identifier or an operator, reduced to its plain name.
ForgetTarget: SpannedValue<String> = {
    <name:"identifier"> => name,
    <operator:Operator> => SpannedValue {
        value: operator.symbol,
        span: operator.span.expect("grammar operators carry spans"),
    },
};

pub Expr: Expr = {
    <let_span:"let"> <tail:LetTail> => let_expression(let_span, tail),
    <cast:Cast> => cast,
    // Lambda literals and `return` sit at the top expression level and
    // greedily take the rest of the expression (parser.y:224-238).
    <open:"("> <parameters:LambdaParameters> <_close:")"> ":" <body:Expr> => {
        lambda(open, parameters, body)
    },
    <rec_span:"rec_fun"> <self_name:"identifier"> <_open:"(">
        <parameters:LambdaParametersOpt> <_close:")">
        <result_type:TypeExprNode> ":" <body:Expr> => {
        rec_lambda(rec_span, self_name, parameters, result_type, body)
    },
    <at:"@"> ":" <body:Expr> => lambda(at, Vec::new(), body),
    <return_span:"return"> <value:Expr> => return_expression(return_span, value),
    // Sequencing (parser.y:243): `tertiary ';' expr`, right-recursive, so
    // `a; b; c` is `a; (b; c)`. `next` (parser.y:236) shares the
    // precedence but yields the FIRST operand's value.
    <first:AssignmentExpr> <_semicolon:";"> <rest:Expr> => sequence(first, rest),
    <first:AssignmentExpr> <_next:"next"> <rest:Expr> => next_sequence(first, rest),
    <expression:AssignmentExpr> => expression,
};

// Lambda parameters (parser.y `id_specs`): `type pattern`, the anonymous
// `type .`, or `(id_spec, …)` destructuring of one argument value. One
// list nonterminal serves both the lambda literal and a tuple parameter,
// so `(int a, int b): body` is a parameter list while `((int a, int b))`
// is a single destructuring parameter.
LambdaParametersOpt: Vec<LambdaParam> = {
    => Vec::new(),
    <parameters:LambdaParameters> => parameters,
};

LambdaParameters: Vec<LambdaParam> = {
    <first:LambdaParam> <rest:("," <LambdaParam>)*> => lambda_parameters(first, rest),
};

LambdaParam: LambdaParam = {
    <type_expr:TypeExprNode> <pattern:Pattern> => lambda_parameter(type_expr, pattern),
    <type_expr:TypeExprNode> <dot:"."> => anonymous_parameter(type_expr, dot),
    <open:"("> <elements:LambdaParameters> <close:")"> => tuple_parameter(open, elements, close),
};

// Binding patterns (parser.y:708-749): named, const `!x`, tuple
// destructuring with omitted slots, the `()` empty tuple, and the
// `(p, …): t` / `: !t` whole-value naming forms, which attach only to a
// comma-separated list. A single pattern in parentheses is grouping and
// collapses. Deferring the `)`/`,` decision into PatternTail keeps the
// grammar LR(1): no reduce competes with the grouping shift.
Pattern: Pattern = {
    <name:"identifier"> => pattern_name(name),
    <bang:"!"> <name:"identifier"> => const_pattern_name(bang, name),
    <open:"("> <close:")"> => pattern_empty_tuple(open, close),
    <open:"("> <first:Pattern> <tail:PatternTail> => finish_pattern(open, first, tail),
    <open:"("> <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*>
        <close:")"> <whole:WholeName?> => {
        pattern_tuple(open, pattern_slots(None, comma, second, rest), close, whole)
    },
};

PatternTail: PatternTail = {
    ")" => PatternTail::Group,
    <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*>
        <close:")"> <whole:WholeName?> => {
        PatternTail::Slots(Box::new(SlotTail {
            comma,
            second,
            rest,
            close,
            whole,
        }))
    },
};

WholeName: Pattern = {
    ":" <name:"identifier"> => pattern_name(name),
    ":" <bang:"!"> <name:"identifier"> => const_pattern_name(bang, name),
};

PatternOpt: Option<Pattern> = {
    => None,
    <pattern:Pattern> => Some(pattern),
};

// `type: expr` sits at the top expression level and greedily takes the rest,
// exactly as upstream (parser.y:224-240).
Cast: Expr = {
    <target:TypeExprNode> <_colon:":"> <body:Expr> => cast_expression(target, body),
};

TypeExprNode: TypeExpr = {
    <prim:"primitive_type"> => type_primitive(prim),
    <span:"void"> => TypeExpr::Void { span },
    <open:"["> <inner:TypeUnionList> <close:"]"> => type_row(open, inner, close),
    <open:"["> <_star:"*"> <close:"]"> => type_wild_row(open, close),
    <open:"("> <inner:TypeUnionList> <close:")"> => type_group(open, inner, close),
    <open:"("> <argument:TypeUnionList?> <_arrow:"->"> <result:TypeUnionList?> <close:")"> => {
        type_function(open, argument, result, close)
    },
};

// A set_type right-hand side (parser.y:753-761 type_spec): a struct or
// union spec with named fields, or a plain type alias. The named/`
// anonymous decision is the token after a type (IDENT or `.`), so the
// plain-type path stays unambiguous.
TypeSpecNode: TypeSpec = {
    <_open:"("> <first:TypeFieldNode> <second:("," <TypeFieldNode>)>
        <rest:("," <TypeFieldNode>)*> <_close:")"> => {
        TypeSpec::Struct({
            let mut fields = vec![first, second];
            fields.extend(rest);
            fields
        })
    },
    <_open:"("> <first:TypeFieldNode> <second:("|" <TypeFieldNode>)>
        <rest:("|" <TypeFieldNode>)*> <_close:")"> => {
        TypeSpec::Union({
            let mut fields = vec![first, second];
            fields.extend(rest);
            fields
        })
    },
    <type_expr:SpecTypeNode> => TypeSpec::Alias(type_expr),
};

TypeFieldNode: TypeField = {
    <type_expr:SpecTypeNode> <name:"identifier"> => named_field(type_expr, name),
    <type_expr:SpecTypeNode> <dot:"."> => anonymous_field(type_expr, dot),
};

// Type expressions inside a `set_type` spec additionally allow defined type
// names (parser.y:784-796). These parallel the shared TypeExprNode rules so
// the extra `"identifier"` alternative never leaks into expression/cast
// contexts and perturbs their LR states.
SpecTypeNode: TypeExpr = {
    <prim:"primitive_type"> => type_primitive(prim),
    <span:"void"> => TypeExpr::Void { span },
    <name:"identifier"> => TypeExpr::Named {
        name: name.value,
        span: name.span,
    },
    <open:"["> <inner:SpecUnionList> <close:"]"> => type_row(open, inner, close),
    <open:"["> <_star:"*"> <close:"]"> => type_wild_row(open, close),
    <open:"("> <inner:SpecUnionList> <close:")"> => type_group(open, inner, close),
    <open:"("> <argument:SpecUnionList?> <_arrow:"->"> <result:SpecUnionList?> <close:")"> => {
        type_function(open, argument, result, close)
    },
};

SpecUnionList: Vec<TypeVariantSlot> = {
    <variant:SpecVariant> => type_union_start(Some(variant), false),
    <_bar:"|"> <variant:SpecVariant?> => type_union_start(variant, true),
    <list:SpecUnionList> <_bar:"|"> <variant:SpecVariant?> => type_union_append(list, variant),
};

SpecVariant: Vec<TypeExpr> = {
    <first:SpecTypeNode> <rest:("," <SpecTypeNode>)*> => type_variant(first, rest),
};

TypeEquations: Vec<TypeDefinition> = {
    <first:TypeEquation> <rest:("," <TypeEquation>)*> => {
        let mut definitions = vec![first];
        definitions.extend(rest);
        definitions
    },
};

TypeEquation: TypeDefinition = {
    <name:"identifier"> <_equals:"="> <spec:TypeSpecNode> => type_definition(name, spec),
};

// `|`-separated variant slots; a missing slot is a void variant. Mirrors
// upstream union_list/types (parser.y:806-818).
TypeUnionList: Vec<TypeVariantSlot> = {
    <variant:TypeVariant> => type_union_start(Some(variant), false),
    <_bar:"|"> <variant:TypeVariant?> => type_union_start(variant, true),
    <list:TypeUnionList> <_bar:"|"> <variant:TypeVariant?> => type_union_append(list, variant),
};

TypeVariant: Vec<TypeExpr> = {
    <first:TypeExprNode> <rest:("," <TypeExprNode>)*> => type_variant(first, rest),
};

LetTail: ParsedLet = {
    <bindings:LetBindings> <_in:"in"> <body:Expr> => finish_let(bindings, body),
    <bindings:LetBindings> <_then:"then"> <tail:LetTail> => prepend_let_group(bindings, tail),
};

LetBindings: Vec<LetBinding> = {
    <first:LetBinding> <rest:("," <LetBinding>)*> => let_bindings(first, rest),
};

LetBinding: LetBinding = {
    <pattern:Pattern> <_equals:"="> <initializer:Expr> => pattern_binding(pattern, initializer),
    // `name(params) = body` and the rec_fun variant desugar to lambda
    // bindings (parser.y:251-257).
    <name:"identifier"> <open:"("> <parameters:LambdaParametersOpt> <_close:")">
        <_equals:"="> <body:Expr> => {
        function_binding(name, open, parameters, body)
    },
    <rec_span:"rec_fun"> <name:"identifier"> <_open:"(">
        <parameters:LambdaParametersOpt> <_close:")"> <_equals:"=">
        <result_type:TypeExprNode> ":" <body:Expr> => {
        rec_function_binding(rec_span, name, parameters, result_type, body)
    },
};

AssignmentExpr: Expr = {
    <name:"identifier"> <_becomes:":="> <value:AssignmentExpr> => assignment(name, value),
    // `set pattern := value` (parser.y:264 tertiary): assignment through a
    // pattern to existing variables. Parsing it keeps `set` legal in
    // expression position — a redirect body parses as `expr` upstream, so
    // `set x = …` there is an error at the `=`, not at the `set`.
    <set:"set"> <pattern:Pattern> <_becomes:":="> <value:AssignmentExpr> => {
        multi_assignment(set, pattern, value)
    },
    <expression:OrExpr> => expression,
};

OrExpr: Expr = {
    <lhs:OrExpr> <_operator:"or"> <rhs:AndExpr> => binary(BinaryOp::Or, lhs, rhs),
    <expression:AndExpr> => expression,
};

AndExpr: Expr = {
    <lhs:AndExpr> <_operator:"and"> <rhs:NotExpr> => binary(BinaryOp::And, lhs, rhs),
    <expression:NotExpr> => expression,
};

NotExpr: Expr = {
    <operator:"not"> <operand:NotExpr> => unary(UnaryOp::Not, operand, operator),
    <expression:Secondary> => expression,
};

Secondary: Expr = {
    <formula:Formula> => formula,
    <postfix:Postfix> => postfix,
};

// This mirrors Atlas's deliberately flat Bison grammar. FormulaStack performs
// the dynamic priority and associativity reductions in parser actions.
Formula: Expr = {
    <stack:FormulaStart> <operand:Operand> => finish_operator_formula(stack, operand),
};

FormulaStart: FormulaStack<Expr> = {
    <operator:Operator> => start_prefix_formula(operator),
    <postfix:Postfix> <operator:Operator> => start_binary_formula(postfix, operator),
    <stack:FormulaStart> <operand:Operand> <operator:Operator> => {
        extend_operator_formula(stack, operand, operator)
    },
};

// A prefix operator following another operator binds immediately, exactly as
// the reference parser's `operand : operator operand` rule requires.
Operand: Expr = {
    <operator:Operator> <operand:Operand> => prefix_operator_call(operator, operand),
    <postfix:Postfix> => postfix,
};

Operator: FormulaOperator = {
    <operator:"operator"> => operator.value,
    <span:"*"> => FormulaOperator::new("*", 6).with_span(span),
    <span:"="> => FormulaOperator::new("=", 2).with_span(span),
};

Postfix: Expr = {
    <base:Atom> <suffixes:PostfixSuffix*> => suffixes.into_iter().fold(base, postfix),
};

PostfixSuffix: PostfixSuffix = {
    <_open:"["> <index:Expr> <close:"]"> => subscription_suffix(index, false, close),
    <_open:"~["> <index:Expr> <close:"]"> => subscription_suffix(index, true, close),
    <subject_reversed:SliceOpen> <lower:Expr?> <lower_reversed:TildeOpt>
        <colon:":"> <upper:Expr?> <upper_reversed:TildeOpt> <close:"]"> => {
        slice_suffix(
            lower,
            upper,
            subject_reversed,
            lower_reversed,
            upper_reversed,
            colon,
            close,
        )
    },
    <_open:"("> <arguments:CallArguments> <close:")"> => call_suffix(arguments, close),
    // `receiver.name` lowers to `name(receiver)`; unit and operator
    // selectors (parser.y:312,321) apply the literal or the operator's
    // prefix form to the receiver.
    <_dot:"."> <name:"identifier"> => selector_suffix(name),
    <_dot:"."> <operator:Operator> => operator_selector(operator),
    <_dot:"."> <unit:UnitSelector> => unit_selector(unit),
};

// `selector: unit` (parser.y:321) — a literal in selector position.
UnitSelector: Expr = {
    <integer:"integer"> => Expr::Integer {
        value: integer.value,
        span: integer.span,
    },
    <boolean:"boolean"> => Expr::Boolean {
        value: boolean.value,
        span: boolean.span,
    },
    <string:"string"> => Expr::String {
        value: string.value,
        span: string.span,
    },
};

#[inline]
SliceOpen: bool = {
    "[" => false,
    "~[" => true,
};

#[inline]
TildeOpt: bool = {
    => false,
    "~" => true,
};

CallArguments: Vec<Expr> = {
    => Vec::new(),
    <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

Atom: Expr = {
    <if_span:"if"> <tail:IfTail> => finish_conditional(if_span, tail),
    <integer:"integer"> => Expr::Integer { value: integer.value, span: integer.span },
    <boolean:"boolean"> => Expr::Boolean { value: boolean.value, span: boolean.span },
    <string:"string"> => Expr::String { value: string.value, span: string.span },
    <identifier:"identifier"> => Expr::Identifier { name: identifier.value, span: identifier.span },
    <open:"["> <elements:ListElements> <close:"]"> => list_expression(open, elements, close),
    <open:"("> <close:")"> => tuple_expression(open, Vec::new(), close),
    <open:"("> <first:Expr> <rest:TupleTail> <close:")"> => {
        tuple_expression(open, expression_list(first, rest), close)
    },
    <open:"("> <inner:Expr> <close:")"> => Expr::Group {
        span: join_span(open, close),
        inner: Box::new(inner),
    },
    <open:"begin"> <inner:Expr> <close:"end"> => Expr::Group {
        span: join_span(open, close),
        inner: Box::new(inner),
    },
    // Loops and `break` are units upstream (parser.y:364,473-474,506-531).
    <while_span:"while"> <tail:WhileTail> => while_expression(while_span, tail),
    <for_span:"for"> <tail:ForTail> => for_expression(for_span, tail),
    <for_span:"for"> <tail:CountedForTail> => counted_for_expression(for_span, tail),
    <span:"break"> => Expr::Break { span },
    // `die` (parser.y:383): a unit that type-checks anywhere and throws
    // `I die` when evaluated.
    <span:"die"> => Expr::Die { span },
    // Case discrimination (parser.y:480-482, caselist): `case subject |
    // tag(pattern): body | tag: body | else body esac`.
    <case:"case"> <subject:Expr> <_bar:"|"> <branches:CaseBranches> <esac:"esac"> => {
        case_expression(case, subject, branches, esac)
    },
    // Integer selection and positional union case (parser.y:350-359).
    <case:"case"> <condition:Expr> <tail:CaseSelectTail> => {
        case_select_expression(case, condition, tail)
    },
};

// The tail of an integer/union `case`: the keyword-permuted `then`/`else`
// variants (parser.y:352-358) normalise into one AST, and the `|` branch
// list marks the positional union form (parser.y:359).
CaseSelectTail: ParsedCaseSelect = {
    "else" <else_branch:Expr> "in" <branches:CaseCommaList> <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase { branches, then_branch: None, else_branch: Some(else_branch), esac }))
    },
    "then" <then_branch:Expr> "in" <branches:CaseCommaList> "else" <else_branch:Expr>
        <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase { branches, then_branch: Some(then_branch), else_branch: Some(else_branch), esac }))
    },
    "then" <then_branch:Expr> "else" <else_branch:Expr> "in" <branches:CaseCommaList>
        <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase { branches, then_branch: Some(then_branch), else_branch: Some(else_branch), esac }))
    },
    "in" <first:Expr> <tail:CaseInTail> => tail.into_case_select(vec![first]),
};

// After `case condition in first`: the branch list continues with `,`
// (integer case), with `|` (positional union case), or ends; the integer
// form may still gain `then`/`else` branches (parser.y:351,355).
CaseInTail: ParsedCaseSelect = {
    <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: None, esac,
    })),
    "else" <else_branch:Expr> <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: Some(else_branch), esac,
    })),
    "then" <then_branch:Expr> "else" <else_branch:Expr> <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase {
            branches: Vec::new(), then_branch: Some(then_branch), else_branch: Some(else_branch), esac,
        }))
    },
    "," <rest:CaseCommaList> <tail:CaseCommaEnd> => tail.into_case_select(rest),
    "|" <second:Expr> <rest:("|" <Expr>)*> <esac:"esac"> => {
        let mut branches = vec![second];
        branches.extend(rest);
        ParsedCaseSelect::Union { branches, esac }
    },
};

CaseCommaEnd: ParsedCaseSelect = {
    <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: None, esac,
    })),
    "else" <else_branch:Expr> <esac:"esac"> => ParsedCaseSelect::Int(Box::new(ParsedIntCase {
        branches: Vec::new(), then_branch: None, else_branch: Some(else_branch), esac,
    })),
    "then" <then_branch:Expr> "else" <else_branch:Expr> <esac:"esac"> => {
        ParsedCaseSelect::Int(Box::new(ParsedIntCase {
            branches: Vec::new(), then_branch: Some(then_branch), else_branch: Some(else_branch), esac,
        }))
    },
};

CaseCommaList: Vec<Expr> = {
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

CaseBranches: Vec<CaseBranch> = {
    <first:CaseBranch> <rest:("|" <CaseBranch>)*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

CaseBranch: CaseBranch = {
    <tag:"identifier"> <_colon:":"> <body:Expr> => case_branch(tag, None, body),
    <tag:"identifier"> <pattern:CasePattern> <_colon:":"> <body:Expr> => {
        case_branch(tag, Some(pattern), body)
    },
    <else_span:"else"> <body:Expr> => else_branch(else_span, body),
};

// Upstream closed_pattern (parser.y:717-720): a parenthesised pattern
// (single patterns collapse), a tuple slot list, or the `()` empty tuple.
// Unlike a let-binding pattern it takes no `: name` whole-value tail — the
// branch `:` would be ambiguous with it — so the tail rules are mirrored
// here minus WholeName.
CasePattern: Pattern = {
    <open:"("> <close:")"> => pattern_empty_tuple(open, close),
    <open:"("> <first:Pattern> <tail:CasePatternTail> => finish_pattern(open, first, tail),
    <open:"("> <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*>
        <close:")"> => {
        pattern_tuple(open, pattern_slots(None, comma, second, rest), close, None)
    },
};

CasePatternTail: PatternTail = {
    ")" => PatternTail::Group,
    <comma:","> <second:PatternOpt> <rest:("," <PatternOpt>)*> <close:")"> => {
        PatternTail::Slots(Box::new(SlotTail {
            comma,
            second,
            rest,
            close,
            whole: None,
        }))
    },
};

// Atlas's do_expr (parser.y:438-443) permits effect-only expressions before
// the guard. Each prefix is evaluated at no-value level; `dont` supplies the
// false guard, while bare `do` supplies true.
WhileTail: (Option<Expr>, Expr, SourceSpan) = {
    <effect:AssignmentExpr> ";" <tail:WhileTail> => prepend_while_effect(effect, tail),
    <dont:"dont"> <od:"od"> => (
        Some(Expr::Boolean { value: false, span: dont }),
        Expr::Dont { span: dont },
        od,
    ),
    <_do:"do"> <body:Expr> <od:"od"> => (None, body, od),
    <condition:AssignmentExpr> <_do:"do"> <body:Expr> <od:"od"> => (Some(condition), body, od),
};

// `FOR pattern_opt ['@' IDENT] IN expr DO expr OD` (parser.y:506-531); the
// loop pattern reuses the let-binding pattern grammar, exactly like the
// upstream pair wrap (pattern, index).
ForTail: ParsedFor = {
    <pattern:ForPattern> <index:ForIndex?> <_in:"in"> <iterable:Expr> <_do:"do">
        <body:Expr> <od:"od"> => {
        ParsedFor { pattern, index, iterable, body, od }
    },
};

// Counted for loops (parser.y:550-573): `FOR IDENT ':' count [FROM bound |
// DOWNTO bound] DO body OD`, or the anonymous `FOR ':' count DO body OD`.
CountedForTail: ParsedCountedFor = {
    <name:"identifier"> ":" <count:Expr> "from" <bound:Expr> "do" <body:Expr> <od:"od"> => {
        ParsedCountedFor { name: Some(name), count, bound: Some(bound), decreasing: false, body, od }
    },
    <name:"identifier"> ":" <count:Expr> "downto" <bound:Expr> "do" <body:Expr> <od:"od"> => {
        ParsedCountedFor { name: Some(name), count, bound: Some(bound), decreasing: true, body, od }
    },
    <name:"identifier"> ":" <count:Expr> "do" <body:Expr> <od:"od"> => {
        ParsedCountedFor { name: Some(name), count, bound: None, decreasing: false, body, od }
    },
    ":" <count:Expr> "do" <body:Expr> <od:"od"> => {
        ParsedCountedFor { name: None, count, bound: None, decreasing: false, body, od }
    },
};

ForPattern: Option<Pattern> = {
    => None,
    <pattern:Pattern> => Some(pattern),
};

ForIndex: SpannedValue<String> = {
    <_at:"@"> <name:"identifier"> => name,
};

// Upstream iftail (parser.y:412-419) plus the inverted else-first form.
IfTail: ParsedIf = {
    <condition:Expr> "then" <then_branch:Expr> "else" <else_branch:Expr> <close:"fi"> => {
        if_tail(condition, then_branch, Some(else_branch), close)
    },
    <condition:Expr> "then" <then_branch:Expr> <close:"fi"> => {
        if_tail(condition, then_branch, None, close)
    },
    <condition:Expr> "then" <then_branch:Expr> "elif" <tail:IfTail> => {
        elif_tail(condition, then_branch, tail)
    },
    <condition:Expr> "else" <else_branch:Expr> "then" <then_branch:Expr> <close:"fi"> => {
        if_tail(condition, then_branch, Some(else_branch), close)
    },
};

TupleTail: Vec<Expr> = {
    <_comma:","> <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

ListElements: Vec<Expr> = {
    => Vec::new(),
    <first:Expr> <rest:("," <Expr>)*> => expression_list(first, rest),
};

extern {
    type Location = usize;
    type Error = ();

    enum ParserToken {
        "integer" => ParserToken::Integer(<SpannedValue<BigInt>>),
        "boolean" => ParserToken::Boolean(<SpannedValue<bool>>),
        "string" => ParserToken::String(<SpannedValue<String>>),
        "identifier" => ParserToken::Identifier(<SpannedValue<String>>),
        "operator" => ParserToken::Operator(<SpannedValue<FormulaOperator>>),
        "primitive_type" => ParserToken::PrimitiveType(<SpannedValue<Prim>>),
        ":=" => ParserToken::Becomes(<SourceSpan>),
        "=" => ParserToken::Equals(<SourceSpan>),
        "*" => ParserToken::Star(<SourceSpan>),
        "void" => ParserToken::VoidType(<SourceSpan>),
        "|" => ParserToken::Bar(<SourceSpan>),
        "->" => ParserToken::Arrow(<SourceSpan>),
        ":" => ParserToken::Colon(<SourceSpan>),
        "," => ParserToken::Comma(<SourceSpan>),
        "[" => ParserToken::LBracket(<SourceSpan>),
        "~[" => ParserToken::ReverseLBracket(<SourceSpan>),
        "]" => ParserToken::RBracket(<SourceSpan>),
        "~" => ParserToken::Tilde(<SourceSpan>),
        "let" => ParserToken::Let(<SourceSpan>),
        "in" => ParserToken::In(<SourceSpan>),
        "begin" => ParserToken::Begin(<SourceSpan>),
        "end" => ParserToken::End(<SourceSpan>),
        "then" => ParserToken::Then(<SourceSpan>),
        "if" => ParserToken::If(<SourceSpan>),
        "else" => ParserToken::Else(<SourceSpan>),
        "elif" => ParserToken::Elif(<SourceSpan>),
        "fi" => ParserToken::Fi(<SourceSpan>),
        "and" => ParserToken::And(<SourceSpan>),
        "or" => ParserToken::Or(<SourceSpan>),
        "not" => ParserToken::Not(<SourceSpan>),
        "return" => ParserToken::Return(<SourceSpan>),
        "rec_fun" => ParserToken::RecFun(<SourceSpan>),
        "while" => ParserToken::While(<SourceSpan>),
        "for" => ParserToken::For(<SourceSpan>),
        "do" => ParserToken::Do(<SourceSpan>),
        "od" => ParserToken::Od(<SourceSpan>),
        "break" => ParserToken::Break(<SourceSpan>),
        "dont" => ParserToken::Dont(<SourceSpan>),
        "die" => ParserToken::Die(<SourceSpan>),
        "?" => ParserToken::Question(<SourceSpan>),
        "set" => ParserToken::Set(<SourceSpan>),
        "set_type" => ParserToken::SetType(<SourceSpan>),
        "whattype" => ParserToken::Whattype(<SourceSpan>),
        "showall" => ParserToken::Showall(<SourceSpan>),
        "forget" => ParserToken::Forget(<SourceSpan>),
        "case" => ParserToken::Case(<SourceSpan>),
        "esac" => ParserToken::Esac(<SourceSpan>),
        "next" => ParserToken::Next(<SourceSpan>),
        "from" => ParserToken::From(<SourceSpan>),
        "downto" => ParserToken::Downto(<SourceSpan>),
        ";" => ParserToken::Semicolon(<SourceSpan>),
        "!" => ParserToken::Bang(<SourceSpan>),
        "@" => ParserToken::At(<SourceSpan>),
        "." => ParserToken::Dot(<SourceSpan>),
        "(" => ParserToken::LParen(<SourceSpan>),
        ")" => ParserToken::RParen(<SourceSpan>),
        "\n" => ParserToken::Newline(<SourceSpan>),
        "unsupported" => ParserToken::Unsupported(<SpannedValue<String>>),
    }
}
