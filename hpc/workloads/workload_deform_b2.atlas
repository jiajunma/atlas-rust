rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
p : Param
q : ParamPol
i : int
r : int
r := 0
while r < 100 do i := 0; while i < 6 do p := param(KGB(rfb,i),[1,1],[1,0]/2); q := deform(p); i := i + 1; () od; r := r + 1; () od
