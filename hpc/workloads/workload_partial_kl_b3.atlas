rb : RootDatum
rb := simply_connected(Lie_type("B3"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0,0],[0,1,0],[0,0,1]])
n : int
n := nr_of_real_forms(ib)
rfb : RealForm
rfb := real_form(ib,n-1)
p : Param
v : ([Param],mat,[vec])
i : int
r : int
r := 0
while r < 3000 do i := 0; while i < 6 do p := param(KGB(rfb,i),[1,1,1],[1,1,0]/2); v := partial_KL_block(p); i := i + 1; () od; r := r + 1; () od
