rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,5),[2,1],[2,1]/1)
alcove_center(p)
q : Param
q := param(KGB(rf,5),[1,0],[3,1]/3)
q
alcove_center(q)
alcove_root_vertex(rd,[0,0])
alcove_root_vertex(rd,[1,1]/3)
alcove_root_vertex(rd,[1,0]/2)
FPP_numers(rd,[0,0])
FPP_w_shifts(rd,[0,0])
FPP_numers(rd,[1,0]/2)
FPP_w_shifts(rd,[1,0]/2)
FPP_numers(rd,[1,1]/3)
FPP_w_shifts(rd,[1,1]/3)
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
alcove_root_vertex(rb,[0,0])
alcove_root_vertex(rb,[1,0]/2)
FPP_numers(rb,[0,0])
FPP_w_shifts(rb,[0,0])
FPP_numers(rb,[1,0]/2)
FPP_w_shifts(rb,[1,0]/2)
rg : RootDatum
rg := simply_connected(Lie_type("G2"),true)
alcove_root_vertex(rg,[0,0])
FPP_numers(rg,[0,0])
FPP_w_shifts(rg,[0,0])
FPP_numers(rg,[1,0]/3)
ra : RootDatum
ra := simply_connected(Lie_type("A1.A1"),true)
alcove_root_vertex(ra,[0,0])
FPP_numers(ra,[0,0])
FPP_w_shifts(ra,[0,0])
rt : RootDatum
rt := simply_connected(Lie_type("A1.T1"),true)
alcove_root_vertex(rt,[0,0])
FPP_numers(rt,[0,0])
