rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,3),[0,0],[1,1]/1)
d : ParamPol
d := deform(p)
d
block_deform(p,d,0)
block_deform(p,d,3)
block_deform(p,d,4)
block_deform(p,d,5)
