to_canonical_fiber("x")
index(3,4,5)
rd : RootDatum
rd := simply_connected(Lie_type("B2"),true)
ic : InnerClass
ic := inner_class(rd,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
df : RealForm
df := dual_real_form(ic,0)
blk : Block
blk := block(rf,df)
x : KGBElt
x := KGB(rf,0)
index(blk,x)
y : KGBElt
y := KGB(rf,0)
index(blk,x,y)
