rd : RootDatum
rd := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(rd,[[1]])
nr_of_Cartan_classes(ic)
cc : CartanClass
cc := Cartan_class(ic,0)
cc
rf : RealForm
rf := real_form(ic,1)
nr_of_Cartan_classes(rf)
cb : CartanClass
cb := Cartan_class(ic,1)
cb
most_split_Cartan(rf)
involution(cc)
involution(cb)
real_forms(cc)
dual_real_forms(cb)
square_classes(cc)
fiber_partition(cc,rf)
Cartan_class(rf,0)
