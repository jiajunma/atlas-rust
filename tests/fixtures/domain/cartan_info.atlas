ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(ra,[[1,0],[0,1]])
c0 : CartanClass
c0 := Cartan_class(ic,0)
Cartan_info(c0)
c1 : CartanClass
c1 := Cartan_class(ic,1)
Cartan_info(c1)
