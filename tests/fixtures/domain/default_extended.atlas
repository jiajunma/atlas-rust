ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(ra,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,1)
p : Param
p := param(x,[0,0],[0,0]/1)
default_extended(p,[[1,0],[0,1]])
x2 : KGBElt
x2 := KGB(rf,2)
p2 : Param
p2 := param(x2,[0,0],[0,0]/1)
default_extended(p2,[[1,0],[0,1]])
x3 : KGBElt
x3 := KGB(rf,3)
p3 : Param
p3 := param(x3,[0,0],[0,0]/1)
default_extended(p3,[[1,0],[0,1]])
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y : KGBElt
y := KGB(rfb,0)
q : Param
q := param(y,[0,0],[0,0]/1)
default_extended(q,[[1,0],[0,1]])
ra3 : RootDatum
ra3 := simply_connected(Lie_type("A3"),true)
ic3 : InnerClass
ic3 := inner_class(ra3,[[1,0,0],[0,1,0],[0,0,1]])
rf3 : RealForm
rf3 := real_form(ic3,1)
x0 : KGBElt
x0 := KGB(rf3,0)
q0 : Param
q0 := param(x0,[0,0,0],[0,0,0]/1)
default_extended(q0,[[0,0,1],[0,1,0],[1,0,0]])
x0 : KGBElt
x0 := KGB(rf,0)
q0 : Param
q0 := param(x0,[0,0],[0,0]/1)
default_extended(q0,[[1,0],[0,1]])
