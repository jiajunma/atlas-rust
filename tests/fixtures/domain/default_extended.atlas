ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(ra,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,1)
p : Param
p := param(x,[0,0],[0,0]/1)
default_extended(p,[[1,0],[0,1]])
x2 : KGBElt
x2 := KGB(rf,2)
p2 : Param
p2 := param(x2,[0,0],[0,0]/1)
default_extended(p2,[[1,0],[0,1]])
x3 : KGBElt
x3 := KGB(rf,3)
p3 : Param
p3 := param(x3,[0,0],[0,0]/1)
default_extended(p3,[[1,0],[0,1]])
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y : KGBElt
y := KGB(rfb,0)
q : Param
q := param(y,[0,0],[0,0]/1)
default_extended(q,[[1,0],[0,1]])
