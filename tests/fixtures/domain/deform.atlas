rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
deform(param(KGB(rf,3),[0,0],[1,1]/1))
deform(param(KGB(rf,4),[0,0],[1,1]/1))
deform(param(KGB(rf,5),[0,0],[0,0]/1))
ra3 : RootDatum
ra3 := simply_connected(Lie_type("A3"),true)
ic3 : InnerClass
ic3 := inner_class(ra3,[[1,0,0],[0,1,0],[0,0,1]])
rf3 : RealForm
rf3 := real_form(ic3,1)
x3 : KGBElt
x3 := KGB(rf3,0)
p3 : Param
p3 := param(x3,[0,0,0],[0,0,0]/1)
deform(p3)
