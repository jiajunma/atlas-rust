rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
pb : Param
pb := param(KGB(rfb,5),[1,1],[1,0]/2)
deform(pb)

ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
ia2 : InnerClass
ia2 := inner_class(ra,[[0,1],[1,0]])
rs : RealForm
rs := real_form(ia2,0)
p3 : Param
p3 := param(KGB(rs,3),[0,0],[1,1]/2)
deform(p3)
