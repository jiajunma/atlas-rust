ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,2)
p : Param
p := param(x,[0],[1]/2)
dual_KL_block(p)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y : KGBElt
y := KGB(rfb,0)
q : Param
q := param(y,[0,0],[0,0]/1)
dual_KL_block(q)
rc : RootDatum
rc := simply_connected(Lie_type("B2"),true)
ic2 : InnerClass
ic2 := inner_class(rc,[[1,0],[0,1]])
rf2 : RealForm
rf2 := real_form(ic2,2)
z : KGBElt
z := KGB(rf2,0)
r : Param
r := param(z,[1,1],[0,0]/1)
dual_KL_block(r)
