rd : RootDatum
rd := simply_connected(Lie_type("A1"),true)
ia : InnerClass
ia := inner_class(rd,[[1]])
fa : RealForm
fa := real_form(ia,1)
pa : Param
pa := param(KGB(fa,0),[0],[0]/1)
pa
scale_extended(pa,[[1]],2/1)
K_type_pol_extended(pa,[[1]])
finalize_extended(pa,[[1]])
pa2 : Param
pa2 := param(KGB(fa,2),[0],[1]/1)
pa2
scale_extended(pa2,[[1]],3/2)
rc : RootDatum
rc := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rc,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
qc : Param
qc := param(KGB(rf,0),[0,0],[0,0]/1)
qc
scale_extended(qc,[[1,0],[0,1]],2/1)
K_type_pol_extended(qc,[[1,0],[0,1]])
finalize_extended(qc,[[1,0],[0,1]])
ic2 : InnerClass
ic2 := inner_class(rc,[[0,1],[1,0]])
rs : RealForm
rs := real_form(ic2,0)
q : Param
q := param(KGB(rs,0),[0,0],[0,0]/1)
q
scale_extended(q,[[0,1],[1,0]],2/1)
K_type_pol_extended(q,[[0,1],[1,0]])
finalize_extended(q,[[0,1],[1,0]])
p : Param
p := param(KGB(rs,3),[1,1],[0,0]/1)
p
finalize_extended(p,[[0,1],[1,0]])
K_type_pol_extended(p,[[0,1],[1,0]])
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
fb : RealForm
fb := real_form(ib,2)
pb : Param
pb := param(KGB(fb,8),[0,0],[0,0]/1)
pb
finalize_extended(pb,[[1,0],[0,1]])
K_type_pol_extended(pb,[[1,0],[0,1]])
