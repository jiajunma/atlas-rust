rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[0,1],[1,0]])
rf : RealForm
rf := real_form(ic,0)
p : Param
p := param(KGB(rf,3),[1,1],[0,0]/1)
p2 : Param
p2 := param(KGB(rf,0),[0,0],[1,0]/1)
scale_extended(p,[[0,1],[1,0]],2/1)
scale_extended(p2,[[0,1],[1,0]],0/1)
scale_extended(p2,[[0,1],[1,0]],2/1)
K_type_pol_extended(p2,[[0,1],[1,0]])
finalize_extended(param(KGB(rf,1),[0,0],[0,0]/1),[[0,1],[1,0]])
scale_extended(p2,[[1,1],[0,1]],2/1)
scale_extended(p2,[[1,0,0],[0,1,0],[0,0,1]],2/1)
ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ia : InnerClass
ia := inner_class(ra,[[1]])
fa : RealForm
fa := real_form(ia,1)
n3 : Param
n3 := param(KGB(fa,1),[-2],[0]/1)
finalize_extended(n3,[[1]])
K_type_pol_extended(n3,[[1]])
scale_extended(n3,[[1]],2/1)
finalize_extended(fa,[[1]])
scale_extended(rf,[[0,1],[1,0]],2/1)
K_type_pol_extended(rf,[[0,1],[1,0]])
