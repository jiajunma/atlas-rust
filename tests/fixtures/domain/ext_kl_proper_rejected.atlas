rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
pb : Param
pb := param(KGB(rfb,5),[1,1],[1,0]/2)
raw_ext_KL(pb,[1,0])
raw_ext_KL(pb)
partial_extended_KL_block(5,[[1,0],[0,1]])
raw_ext_KL(pb,[[1,1],[0,1]])
partial_extended_KL_block(pb,[[1,0],[0,-1]])
extended_block(pb,[[-1,0],[0,-1]])
