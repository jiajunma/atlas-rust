ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,1)
p : Param
p := param(x,[0],[1]/2)
full_deform(p)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y : KGBElt
y := KGB(rfb,0)
q : Param
q := param(y,[0,0],[0,0]/1)
full_deform(q)
rc2 : RootDatum
rc2 := simply_connected(Lie_type("B2"),true)
ic2 : InnerClass
ic2 := inner_class(rc2,[[1,0],[0,1]])
rfc2 : RealForm
rfc2 := real_form(ic2,1)
z : KGBElt
z := KGB(rfc2,0)
r : Param
r := param(z,[0,0],[0,0]/1)
full_deform(r)
rg : RootDatum
rg := simply_connected(Lie_type("G2"),true)
ig : InnerClass
ig := inner_class(rg,[[1,0],[0,1]])
rfg : RealForm
rfg := real_form(ig,1)
z3 : KGBElt
z3 := KGB(rfg,0)
r3 : Param
r3 := param(z3,[0,0],[0,0]/1)
full_deform(r3)
