rd : RootDatum
rd := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(rd,[[1]])
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,0),[1],[0]/1)
scale_extended(p,[[1]],2/1)
K_type_pol_extended(p,[[1]])
finalize_extended(p,[[1]])
deform(p)
twisted_deform(p)
twisted_full_deform(p)
twisted_KL_sum_at_s(p)
twisted_KL_sum_at_s(p,[[1]])
