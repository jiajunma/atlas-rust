ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
integrality_rank(ra,[1,0]/1)
integrality_rank(ra,[1,0]/2)
integrality_datum(ra,[1,0]/1)
is_integrally_dominant(ra,[1,0]/1)
is_integrally_dominant(ra,[-1,0]/1)
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
integrality_rank(rb,[1,0]/1)
integrality_datum(rb,[1,0]/1)
is_integrally_dominant(rb,[1,1]/1)
is_integrally_dominant(rb,[-1,0]/1)
