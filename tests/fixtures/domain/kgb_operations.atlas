rd : RootDatum
rd := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(rd,[[1]])
rf : RealForm
rf := real_form(ic,1)
x0 : KGBElt
x0 := KGB(rf,0)
x1 : KGBElt
x1 := KGB(rf,1)
x2 : KGBElt
x2 := KGB(rf,2)
cross(0,x0)
cross(0,x1)
Cayley(0,x0)
Cayley(0,x2)
length(x0)
length(x2)
torus_factor(x0)
x0=x1
x0!=x1
%x0
twist(x0)
involution(x0)
rc : RealForm
rc := real_form(ic,0)
c0 : KGBElt
c0 := KGB(rc,0)
Cayley(0,c0)
cross(0,c0)
