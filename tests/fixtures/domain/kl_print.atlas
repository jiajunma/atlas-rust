ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(ra,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
df : RealForm
df := dual_real_form(ic,0)
blk : Block
blk := block(rf,df)
print_KL_basis(blk)
print_prim_KL(blk)
print_KL_list(blk)
print_W_graph(blk)
print_W_cells(blk)
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
dfb : RealForm
dfb := dual_real_form(ib,1)
blkb : Block
blkb := block(rfb,dfb)
print_KL_basis(blkb)
print_prim_KL(blkb)
print_W_graph(blkb)
print_W_cells(blkb)
rg : RootDatum
rg := simply_connected(Lie_type("G2"),true)
ig : InnerClass
ig := inner_class(rg,[[1,0],[0,1]])
rfg : RealForm
rfg := real_form(ig,1)
dfg : RealForm
dfg := dual_real_form(ig,1)
blkg : Block
blkg := block(rfg,dfg)
print_W_graph(blkg)
print_W_cells(blkg)
print_KL_basis(blkg)
print_KL_list(blkb)
print_KL_list(blkg)
