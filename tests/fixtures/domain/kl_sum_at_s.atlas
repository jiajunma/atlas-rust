ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,1)
p : Param
p := param(x,[0],[1]/2)
KL_sum_at_s(p)
KL_sum_at_s_to_height(p,0)
KL_sum_at_s_to_height(p,-1)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y : KGBElt
y := KGB(rfb,0)
q : Param
q := param(y,[0,0],[0,0]/1)
KL_sum_at_s(q)
rc : RootDatum
rc := simply_connected(Lie_type("B2"),true)
ic2 : InnerClass
ic2 := inner_class(rc,[[1,0],[0,1]])
rfc : RealForm
rfc := real_form(ic2,2)
z : KGBElt
z := KGB(rfc,0)
r : Param
r := param(z,[0,0],[0,0]/1)
KL_sum_at_s(r)
rd : RootDatum
rd := simply_connected(Lie_type("A3"),true)
id : InnerClass
id := inner_class(rd,[[1,0,0],[0,1,0],[0,0,1]])
rfd : RealForm
rfd := real_form(id,1)
z2 : KGBElt
z2 := KGB(rfd,0)
r2 : Param
r2 := param(z2,[0,0,0],[0,0,0]/1)
KL_sum_at_s(r2)
