rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
P : KTypePol
P := null_K_module(rf)
Q1 : KTypePol
Q1 := P + K_type(KGB(rf,5),[0,0])
Q1
Q2 : KTypePol
Q2 := P + K_type(KGB(rf,4),[1,0])
Q2
#Q2
Q3 : KTypePol
Q3 := P + K_type(KGB(rf,5),[1,0])
Q3
2*Q2
