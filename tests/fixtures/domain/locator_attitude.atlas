rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
pb : Param
pb := param(KGB(rfb,5),[1,1],[1,0]/2)
twisted_deform(pb)
print_partial_common_block(pb)
q2 : Param
q2 := param(KGB(rfb,10),[0,0],[1,1]/2)
print_partial_common_block(q2)
print_partial_common_block(pb)
twisted_KL_sum_at_s(q2)
twisted_full_deform(q2)
twisted_full_deform(pb)
print_partial_common_block(q2)
print_partial_common_block(pb)
