rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
root_ladder_bottoms(rb,0)
root_ladder_bottoms(rb,1)
root_ladder_bottoms(rb,2)
root_ladder_bottoms(rb,3)
root_ladder_bottoms(rb,-1)
coroot_ladder_bottoms(rb,0)
coroot_ladder_bottoms(rb,3)
basic_orbit_ws(rb,[0,1],1)
basic_orbit_ws(rb,[1,0],1)
basic_orbit_ws(rb,[0,2],1)
basic_orbit_ws(rb,[1,3],1)
basic_orbit_ws(rb,[-4,1],1)
basic_orbit_ws(rb,[0,1,-3],2)
basic_orbit_ws(rb,[0,1,-4],2)
affine_orbit_ws(rb,[0,0]/1)
affine_orbit_ws(rb,[1,0]/2)
affine_orbit_ws(rb,[1,1]/3)
ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
basic_orbit_ws(ra,[0,-1],1)
g2 : RootDatum
g2 := adjoint(Lie_type("G2"),false)
root_ladder_bottoms(g2,5)
basic_orbit_ws(g2,[0,1],1)
basic_orbit_ws(g2,[0,1,-6],2)
affine_orbit_ws(g2,[0,0]/1)
