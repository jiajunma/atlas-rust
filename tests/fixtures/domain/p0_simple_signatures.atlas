rd : RootDatum
rd := simply_connected(Lie_type("A1"),true)
from_dominant(rd,[3])
from_dominant([3],rd)
ic : InnerClass
ic := inner_class(rd,[[1]])
Cartan_info(Cartan_class(ic,0))
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,1),[0],[1]/2)
KL_block(p)
KL_column(p)
cross(0,p)
Cayley(0,p)
