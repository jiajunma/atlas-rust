rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[0,1],[1,0]])
rf : RealForm
rf := real_form(ic,0)
p : Param
p := param(KGB(rf,1),[0,0],[0,0]/1)
twist(p)
twist(p,distinguished_involution(ic))
twist(p,[[1,0],[0,1]])
(twist(p);7)
(twist(p,[[1,0],[0,1]]);8)
