rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(rd,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,5),[0,0],[0,0]/1)
cross(root(rd,0),p)
Cayley(root(rd,0),p)=p
cross(root(rd,0)+root(rd,1),p)
Cayley(root(rd,0)+root(rd,1),p)
cross(-root(rd,0),p)
Cayley(-root(rd,0),p)
q : Param
q := param(KGB(rf,5),[0,0],[1,0]/2)
(cross([2],p);7)
(Cayley([2],p);8)
(cross(root(rd,0),q);9)
(Cayley(root(rd,0),q);10)
