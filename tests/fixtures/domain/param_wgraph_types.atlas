rd : RootDatum
rd := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(rd,[[1]])
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,1),[0],[1]/2)
g : (int,[([int],[(int,int)])])
g := W_graph(p)
let (s,vs)=g in let (desc,edges)=vs[0] in let (target,mu)=edges[0] in (s,#vs,#desc,target,mu)
c : (int,[([int],[([int],[(int,int)])])])
c := W_cells(p)
let (s,cs)=c in let (members,vs)=cs[0] in let (desc,edges)=vs[0] in (s,#cs,members,desc,#edges)
