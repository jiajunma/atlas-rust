ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,2)
p : Param
p := param(x,[0],[1]/2)
partial_block(p)
x1 : KGBElt
x1 := KGB(rf,1)
p1 : Param
p1 := param(x1,[0],[1]/2)
partial_block(p1)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y0 : KGBElt
y0 := KGB(rfb,0)
q0 : Param
q0 := param(y0,[0,0],[0,0]/1)
partial_block(q0)
rc : RootDatum
rc := simply_connected(Lie_type("B2"),true)
ic2 : InnerClass
ic2 := inner_class(rc,[[1,0],[0,1]])
rfc : RealForm
rfc := real_form(ic2,1)
z : KGBElt
z := KGB(rfc,0)
r : Param
r := param(z,[0,0],[0,0]/1)
partial_block(r)
