ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,2)
p : Param
p := param(x,[0],[1]/2)
partial_block(p)
x1 : KGBElt
x1 := KGB(rf,1)
p1 : Param
p1 := param(x1,[0],[1]/2)
partial_block(p1)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
