ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
x : KGBElt
x := KGB(rf,1)
p : Param
p := param(x,[0],[1]/2)
partial_KL_block(p)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y0 : KGBElt
y0 := KGB(rfb,0)
q0 : Param
q0 := param(y0,[0,0],[0,0]/1)
partial_KL_block(q0)
rc : RootDatum
rc := simply_connected(Lie_type("B2"),true)
ic2 : InnerClass
ic2 := inner_class(rc,[[1,0],[0,1]])
rfc : RealForm
rfc := real_form(ic2,2)
z : KGBElt
z := KGB(rfc,0)
r : Param
r := param(z,[0,0],[0,0]/1)
partial_KL_block(r)
ra3 : RootDatum
ra3 := simply_connected(Lie_type("A3"),true)
ic3 : InnerClass
ic3 := inner_class(ra3,[[1,0,0],[0,1,0],[0,0,1]])
rf3 : RealForm
rf3 := real_form(ic3,1)
x3 : KGBElt
x3 := KGB(rf3,0)
p3 : Param
p3 := param(x3,[0,0,0],[0,0,0]/1)
partial_KL_block(p3)
