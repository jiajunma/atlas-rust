ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
c0 : CartanClass
c0 := Cartan_class(ic,0)
print_gradings(c0,real_form(ic,0))
print_gradings(c0,real_form(ic,1))
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rf1 : RealForm
rf1 := real_form(ib,1)
rf2 : RealForm
rf2 := real_form(ib,2)
cb0 : CartanClass
cb0 := Cartan_class(ib,0)
print_gradings(cb0,real_form(ib,0))
cb1 : CartanClass
cb1 := Cartan_class(ib,1)
print_gradings(cb1,rf2)
cb2 : CartanClass
cb2 := Cartan_class(ib,2)
print_gradings(cb2,rf1)
print_gradings(cb2,rf2)
ra2 : RootDatum
ra2 := simply_connected(Lie_type("A2"),true)
ia : InnerClass
ia := inner_class(ra2,[[1,0],[0,1]])
ca0 : CartanClass
ca0 := Cartan_class(ia,0)
print_gradings(ca0,real_form(ia,0))
print_gradings(ca0,real_form(ia,1))
ca1 : CartanClass
ca1 := Cartan_class(ia,1)
print_gradings(ca1,real_form(ia,1))
