rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
cb1 : CartanClass
cb1 := Cartan_class(ib,1)
print_gradings(cb1,real_form(ib,0))
print_gradings(cb1,real_form(ib,1))
cb2 : CartanClass
cb2 := Cartan_class(ib,2)
print_gradings(cb2,real_form(ib,0))
print_gradings(cb1)
print_gradings(real_form(ib,1),cb1)
