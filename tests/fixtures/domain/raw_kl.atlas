ra : RootDatum
ra := simply_connected(Lie_type("A2"),true)
ic : InnerClass
ic := inner_class(ra,[[1,0],[0,1]])
rf : RealForm
rf := real_form(ic,1)
df : RealForm
df := dual_real_form(ic,0)
blk : Block
blk := block(rf,df)
raw_KL(blk)
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
dfb : RealForm
dfb := dual_real_form(ib,1)
blkb : Block
blkb := block(rfb,dfb)
raw_KL(blkb)
rc : RootDatum
rc := simply_connected(Lie_type("B2"),true)
ic2 : InnerClass
ic2 := inner_class(rc,[[1,0],[0,1]])
rfc : RealForm
rfc := real_form(ic2,2)
dfc : RealForm
dfc := dual_real_form(ic2,2)
blkc : Block
blkc := block(rfc,dfc)
raw_KL(blkc)
rg : RootDatum
rg := simply_connected(Lie_type("G2"),true)
ig : InnerClass
ig := inner_class(rg,[[1,0],[0,1]])
rfg : RealForm
rfg := real_form(ig,1)
dfg : RealForm
dfg := dual_real_form(ig,1)
blkg : Block
blkg := block(rfg,dfg)
raw_KL(blkg)
rd : RootDatum
rd := simply_connected(Lie_type("A3"),true)
id : InnerClass
id := inner_class(rd,[[1,0,0],[0,1,0],[0,0,1]])
rfd : RealForm
rfd := real_form(id,1)
dfd : RealForm
dfd := dual_real_form(id,1)
blkd : Block
blkd := block(rfd,dfd)
raw_KL(blkd)
