ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
ca0 : CartanClass
ca0 := Cartan_class(ic,0)
ca1 : CartanClass
ca1 := Cartan_class(ic,1)
print_real_Weyl(real_form(ic,0),ca1)
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
cb0 : CartanClass
cb0 := Cartan_class(ib,0)
print_real_Weyl(real_form(ic,1),cb0)
print_real_Weyl(ca0,real_form(ic,0))
Ba : Block
Ba := block(real_form(ic,1),dual_real_form(ic,1))
print_blockstabilizer(ca0,Ba)
