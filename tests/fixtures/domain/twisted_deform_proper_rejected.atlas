rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,2)
pb : Param
pb := param(KGB(rfb,5),[1,1],[1,0]/2)
c10 : Param
c10 := param(KGB(rfb,10),[1,1],[1,0]/2)
twisted_deform(c10)
twisted_deform(pb,[[1,0],[0,1]])
twisted_deform(pb,rfb)
twisted_deform(5)
