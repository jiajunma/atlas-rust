ra : RootDatum
ra := simply_connected(Lie_type("A1"),true)
ic : InnerClass
ic := inner_class(ra,[[1]])
rf : RealForm
rf := real_form(ic,1)
p : Param
p := param(KGB(rf,2),[0],[1]/2)
twisted_deform(p)
twisted_KL_sum_at_s(p)
q : Param
q := param(KGB(rf,0),[1],[0]/1)
twisted_deform(q)
twisted_KL_sum_at_s(q)
twisted_full_deform(q)
rb : RootDatum
rb := simply_connected(Lie_type("A2"),true)
ib : InnerClass
ib := inner_class(rb,[[1,0],[0,1]])
rfb : RealForm
rfb := real_form(ib,1)
y : KGBElt
y := KGB(rfb,0)
q2 : Param
q2 := param(y,[0,0],[0,0]/1)
twisted_deform(q2)
twisted_full_deform(q2)
twisted_KL_sum_at_s(q2)
twisted_KL_sum_at_s(q2,[[1,0],[0,1]])
