rd : RootDatum
rd := simply_connected(Lie_type("A2"),true)
Weyl_orbit(rd,[1,1])
Weyl_orbit(rd,[1,0])
Weyl_orbit([1,1],rd)
Weyl_orbit([2,1],rd)
Weyl_orbit(rd,[0,0])
Weyl_orbit_ws(rd,[1,1])
Weyl_orbit_ws(rd,[1,0])
Weyl_orbit_ws([1,1],rd)
Weyl_orbit_ws([0,0],rd)
rb : RootDatum
rb := simply_connected(Lie_type("B2"),true)
