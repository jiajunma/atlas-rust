{ Core-only rank-one Weyl owner/lifetime discovery. No atlas scripts. }
set wc_rd=simply_connected(Lie_type("A1"),true)
set wc_saved=W_elt(wc_rd,[0])
prints("WC_SAME|",word(wc_saved),"|",length(wc_saved),"|",root_permutation(wc_saved),"|",word(W_elt(wc_rd,[0,0])))
set wc_alias=wc_rd
set wc_alias_w=W_elt(wc_alias,[0])
prints("WC_ALIAS|",wc_alias=wc_rd,"|",root_datum(wc_alias_w)=wc_rd,"|",wc_saved=wc_alias_w,"|",word(wc_saved*wc_alias_w))
set wc_equal=simply_connected(Lie_type("A1"),true)
set wc_equal_w=W_elt(wc_equal,[0])
prints("WC_EQUAL|",wc_equal=wc_rd,"|",root_datum(wc_equal_w)=wc_equal,"|",wc_saved=wc_equal_w,"|",word(wc_saved*wc_equal_w))
set wc_dual=dual(wc_rd)
set wc_dual_w=W_elt(wc_dual,[0])
prints("WC_DUAL_COLD_OWNER|",wc_dual=adjoint(Lie_type("A1"),false))
prints("WC_DUAL_COLD_EQ|",wc_saved=wc_dual_w)
prints("WC_DUAL_COLD_NEQ|",wc_saved!=wc_dual_w)
prints("WC_DUAL_COLD_MUL|",word(wc_saved*wc_dual_w))
set wc_reverse_target=adjoint(Lie_type("A1"),true)
set wc_reverse_target_w=W_elt(wc_reverse_target,[0])
set wc_reverse_source=dual(wc_reverse_target)
set wc_reverse_source_w=W_elt(wc_reverse_source,[0])
prints("WC_DUAL_REVERSE_OWNER|",wc_reverse_source=simply_connected(Lie_type("A1"),false))
prints("WC_DUAL_REVERSE_EQ|",wc_reverse_target_w=wc_reverse_source_w)
prints("WC_DUAL_REVERSE_NEQ|",wc_reverse_target_w!=wc_reverse_source_w)
prints("WC_DUAL_REVERSE_MUL|",word(wc_reverse_target_w*wc_reverse_source_w),"|",root_datum(wc_reverse_target_w*wc_reverse_source_w)=wc_reverse_target)
set wc_rd=simply_connected(Lie_type("A1"),false)
set wc_rebound_w=W_elt(wc_rd,[0])
prints("WC_REBOUND|",prefers_coroots(wc_rd),"|",root_permutation(wc_rebound_w),"|",root_datum(wc_saved)=wc_alias,"|",root_datum(wc_saved)=wc_rd,"|",word(wc_saved),"|",root_permutation(wc_saved))
prints("WC_RECOVERY|",727)
