{ Core-only rank-one Weyl rejection/history discovery. Every error recovers. }
set wcn_true=simply_connected(Lie_type("A1"),true)
set wcn_false=simply_connected(Lie_type("A1"),false)
set wcn_false_w=W_elt(wcn_false,[0])
set wcn_target=adjoint(Lie_type("A1"),false)
set wcn_target_w=W_elt(wcn_target,[0])
set wcn_dual=dual(wcn_true)
set wcn_saved=W_elt(wcn_true,[0])
set wcn_dual_w=W_elt(wcn_dual,[0])
prints("WCN_OWNER_EQ|",wcn_saved=wcn_false_w)
prints("WCN_AFTER_OWNER_EQ|",word(wcn_saved),"|",root_permutation(wcn_saved))
prints("WCN_OWNER_NEQ|",wcn_saved!=wcn_false_w)
prints("WCN_AFTER_OWNER_NEQ|",word(wcn_saved),"|",root_permutation(wcn_saved))
wcn_saved*wcn_false_w
prints("WCN_AFTER_OWNER_MUL|",word(wcn_saved),"|",root_permutation(wcn_saved))
W_elt(wcn_true,[1])
prints("WCN_AFTER_HIGH|",word(wcn_saved))
W_elt(wcn_true,[-1])
prints("WCN_AFTER_NEGATIVE|",word(wcn_saved))
prints("WCN_DUAL_PREWARM_EQ|",wcn_saved=wcn_dual_w)
prints("WCN_AFTER_DUAL_EQ|",word(wcn_target_w),"|",wcn_dual=wcn_target)
prints("WCN_DUAL_PREWARM_NEQ|",wcn_saved!=wcn_dual_w)
prints("WCN_AFTER_DUAL_NEQ|",word(wcn_target_w),"|",wcn_dual=wcn_target)
wcn_saved*wcn_dual_w
prints("WCN_AFTER_DUAL_MUL|",word(wcn_saved),"|",word(wcn_target_w),"|",wcn_dual=wcn_target)
prints("WCN_RECOVERY|",733)
