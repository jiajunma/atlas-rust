{ G2 Weyl owner/dual cold witness: asymmetric interface order, noncommuting
  words and the braid relation. Provisional until complete original behavior
  is captured on HPC. No atlas scripts. }
set wg_rd=simply_connected(Lie_type("G2"),true)
set wg_s0=W_elt(wg_rd,[0])
set wg_s1=W_elt(wg_rd,[1])
prints("WG_SAME|",word(wg_s0),"|",length(wg_s0),"|",length(wg_s1),"|",word(W_elt(wg_rd,[0,1])))
prints("WG_NONCOMMUTE|",word(wg_s0*wg_s1),"|",word(wg_s1*wg_s0))
prints("WG_BRAID|",wg_s0*wg_s1*wg_s0*wg_s1*wg_s0*wg_s1=wg_s1*wg_s0*wg_s1*wg_s0*wg_s1*wg_s0,"|",length(wg_s0*wg_s1*wg_s0*wg_s1*wg_s0*wg_s1))
set wg_alias=wg_rd
set wg_alias_w=W_elt(wg_alias,[0,1])
prints("WG_ALIAS|",wg_alias=wg_rd,"|",wg_s0*wg_s1=wg_alias_w)
set wg_equal=simply_connected(Lie_type("G2"),true)
set wg_equal_w=W_elt(wg_equal,[0,1])
prints("WG_EQUAL|",wg_equal=wg_rd,"|",wg_s0*wg_s1=wg_equal_w)
set wg_dual=dual(wg_rd)
set wg_dual_w=W_elt(wg_dual,[0])
prints("WG_DUAL_OWNER|",wg_dual=adjoint(Lie_type("G2"),false))
prints("WG_DUAL_EQ|",wg_s0=wg_dual_w)
prints("WG_DUAL_NEQ|",wg_s0!=wg_dual_w)
prints("WG_DUAL_MUL|",word(wg_s0*wg_dual_w))
set wg_reverse_target=adjoint(Lie_type("G2"),true)
set wg_reverse_target_w=W_elt(wg_reverse_target,[0])
set wg_reverse_source=dual(wg_reverse_target)
set wg_reverse_source_w=W_elt(wg_reverse_source,[0])
prints("WG_REVERSE_OWNER|",wg_reverse_source=simply_connected(Lie_type("G2"),false))
prints("WG_REVERSE_EQ|",wg_reverse_target_w=wg_reverse_source_w)
prints("WG_REVERSE_NEQ|",wg_reverse_target_w!=wg_reverse_source_w)
prints("WG_REVERSE_MUL|",word(wg_reverse_target_w*wg_reverse_source_w),"|",root_datum(wg_reverse_target_w*wg_reverse_source_w)=wg_reverse_target)
set wg_rd=simply_connected(Lie_type("G2"),false)
set wg_rebound_w=W_elt(wg_rd,[1])
prints("WG_REBOUND|",prefers_coroots(wg_rd),"|",root_datum(wg_s0)=wg_alias,"|",root_datum(wg_s0)=wg_rd,"|",word(wg_s0),"|",word(wg_rebound_w))
prints("WG_RECOVERY|",727)
