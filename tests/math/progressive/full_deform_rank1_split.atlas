{ Bare split A1: complete split coefficients, singular/nonintegral/integral
  inputs, multiple reducibility points, cold and KL-warmed cache histories. }
prints("FULL_DEFORM_SPLIT_BEGIN")
for prefer in [false,true] do
 let rd=simply_connected(Lie_type("A1"),prefer)
 then G=real_form(inner_class(rd,[[1]]),1) in
 for nu in [[0]/1,[1]/2,[1]/1,[3]/2,[3]/1,[5]/1] do
  let p=param(KGB(G,2),[0],nu) in
  prints("FULL_DEFORM_ROW|",prefer,"|",p,"|FINAL|",is_final(p));
  prints("FULL_DEFORM_COLD|",full_deform(p));
  prints("FULL_DEFORM_KL|",KL_sum_at_s(p));
  prints("FULL_DEFORM_WARM|",full_deform(p))
 od
od
prints("FULL_DEFORM_RECOVERY|",683)
