<hodge_test.at
hodge_test_verbose:=false
set G=split_form(Lie_type("@TYPE@"))
set p=trivial(G)*(@SCALE@)
prints("MATH_BEGIN @ID@")
prints("GROUP",G,"PARAMETER",p,"GAMMA",infinitesimal_character(p),"BOUND",@BOUND@)
assert(not (p=trivial(G)),"nontrivial Hodge probe unexpectedly became trivial")
prints("FINAL",is_final(p),"FINITE_DIMENSIONAL",is_finite_dimensional(p))
prints("CHARACTER_FORMULA",character_formula(p))
prints("HODGE_STD",rearrange(hodge_grading_std(p)))
prints("HODGE_IRR",rearrange(hodge_grading_irreducible(p)))
set HS=hodge_branch_std(p,@BOUND@)
prints("STD_BACK_TRACE",back_trace)
set HI=hodge_branch_irr(p,@BOUND@)
prints("IRR_BACK_TRACE",back_trace)
prints("HODGE_BRANCH_STD",rearrange(HS))
prints("HODGE_BRANCH_IRR",rearrange(HI))
prints("UNGRADED_BRANCH_STD",branch_std(p,@BOUND@))
assert(HS.v_to_1=branch_std(p,@BOUND@),"Hodge branching specialization at1 failed")
set (kindex,ktypes,A,B)=hodge_K_type_mat_long(LKT(p),@BOUND@)
prints("HODGE_K_MATRIX_INDEX",kindex,"K_TYPES",ktypes,"A",A,"B",B)
assert(test_positive(B),"Hodge K multiplicity matrix has a negative coefficient")
set (checks,passed)=hodge_test(p,@BOUND@)
prints("SPECIALIZATIONS",checks)
assert(passed,"Hodge specialization identity failed")
prints("MATH_END @ID@")
